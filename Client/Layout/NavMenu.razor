<AuthorizeView>
    <Authorized>

        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" style="cursor:pointer;" @onclick="HomeClicked">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </a>
                <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>

        <div class="@NavMenuCssClass nav-scrollable">
            <nav class="flex-column">

                @* {{!-- ADMINISTRATION (Admin only) --}} *@
                <AuthorizeView Roles="Admin" Context="adminCtx">
                    <Authorized> 
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="ShowAdminMenuContainer">
                                <div class="hstack gap-2">
                                    <span class="bi bi-person-fill fs-5" aria-hidden="true"></span>
                                    <span>Administration</span>
                                </div>
                            </a>
                            @if (ShowHide)
                            {
                                <div style="margin-left:1.5rem;">
                                    <a class="nav-link p-2 text-white" style="cursor:pointer;" @onclick="UserClicked">
                                        <div class="hstack gap-2">
                                            <span class="bi bi-people fs-5" aria-hidden="true"></span>
                                            <span>Users</span>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                  </Authorized>
                </AuthorizeView> 

                @* {{!-- MANAGEMENT (all authenticated users) --}} *@
                <div class="nav-item px-3">
                    <a class="nav-link p-2" style="cursor:pointer;" @onclick="ShowDepartmentContainer">
                        <div class="hstack gap-2">
                            <span class="bi bi-backpack4-fill fs-5" aria-hidden="true"></span>
                            <span>Management</span>
                        </div>
                    </a>
                    @if (ShowHideDepartment)
                    {
                        <div style="margin-left:1.5rem;">
                            <a class="nav-link p-2 text-white" style="cursor:pointer;" @onclick="GeneralDepartmentClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-file-medical fs-5" aria-hidden="true"></span>
                                    <span>General Dep</span>
                                </div>
                            </a>
                            <a class="nav-link p-2 text-white" style="cursor:pointer;" @onclick="DepartmentClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-substack fs-5" aria-hidden="true"></span>
                                    <span>Department</span>
                                </div>
                            </a>
                            <a class="nav-link p-2 text-white" style="cursor:pointer;" @onclick="BranchClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-chevron-bar-contract fs-5" aria-hidden="true"></span>
                                    <span>Branch</span>
                                </div>
                            </a>
                        </div>

                        <hr class="border-secondary mx-3" />
                        @* { { !--LOCATION--} } *@
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="CountryClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-geo-alt fs-5" aria-hidden="true"></span>
                                    <span>Country</span>
                                </div>
                            </a>
                        </div>
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="CityClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-pin-map-fill fs-5" aria-hidden="true"></span>
                                    <span>City</span>
                                </div>
                            </a>
                        </div>
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="TownClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-geo fs-5" aria-hidden="true"></span>
                                    <span>Town</span>
                                </div>
                            </a>
                        </div>

                        <hr class="border-secondary mx-3" />
                        @* { {!--TYPES--} } *@
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="OvertimeTypeClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-stopwatch fs-5" aria-hidden="true"></span>
                                    <span>Overtime Type</span>
                                </div>
                            </a>
                        </div>
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="SanctionTypeClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-x-octagon fs-5" aria-hidden="true"></span>
                                    <span>Sanction Type</span>
                                </div>
                            </a>
                        </div>
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="VacationTypeClicked">
                                <div class="hstack gap-2">
                                    <span class="bi bi-backpack3 fs-5" aria-hidden="true"></span>
                                    <span>Vacation Type</span>
                                </div>
                            </a>
                        </div>

                        <hr class="border-secondary mx-3" />
                        @* { {!--EMPLOYEES--} } *@
                        <div class="nav-item px-3">
                            <a class="nav-link p-2" style="cursor:pointer;" @onclick="EmployeeClicked">
                        <div class="hstack gap-2">
                            <span class="bi bi-people-fill fs-5" aria-hidden="true"></span>
                            <span>Employees</span>
                        </div>
                    </a>
                </div>
                }
                </div>

                @* {{!-- FEEDBACK / SENTIMENT (all authenticated users) --}} *@
                <div class="nav-item px-3" style="margin-top:0.5rem;">
                    <a class="nav-link p-2" style="cursor:pointer;" @onclick="FeedbackClicked">
                        <div class="hstack gap-2">
                            <span class="bi bi-chat-heart-fill fs-5" aria-hidden="true"></span>
                            <span>Feedback</span>
                        </div>
                    </a>
                </div>

            </nav>
        </div>


    </Authorized>
    <NotAuthorized>
        {{!-- Nav hidden when not logged in --}}
    </NotAuthorized>
</AuthorizeView>

<style>
    .nav-link {
        color: rgba(255,255,255,0.8) !important;
    }

    .nav-link:hover {
        color: white !important;
        background-color: rgba(255,255,255,0.1);
        border-radius: 4px;
    }

    .hstack .bi {
        line-height: 1;
        display: flex;
        align-items: center;
    }

    .hstack span:not(.bi) {
        line-height: 1.5;
        margin-top: 2px; 
    }
</style>

@code {
    private bool collapseNavMenu = false;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    // Administration
    public bool ShowHide { get; set; } = false;
    private void ShowAdminMenuContainer() => ShowHide = !ShowHide;

    // Management
    public bool ShowHideDepartment { get; set; } = false;
    private void ShowDepartmentContainer() => ShowHideDepartment = !ShowHideDepartment;

    void HomeClicked()
    {
        allState.EmployeeClicked();
        NavManager.NavigateTo("/home/dashboard");
    }

    void GeneralDepartmentClicked() => allState.GeneralDepartmentClicked();
    void DepartmentClicked() => allState.DepartmentClicked();
    void BranchClicked() => allState.BranchClicked();
    void CountryClicked() => allState.CountryClicked();
    void CityClicked() => allState.CityClicked();
    void TownClicked() => allState.TownClicked();
    void OvertimeTypeClicked() => allState.OvertimeTypeClicked();
    void SanctionTypeClicked() => allState.SanctionTypeClicked();
    void VacationTypeClicked() => allState.VacationTypeClicked();
    void UserClicked() => allState.UserClicked();
    void EmployeeClicked() => allState.EmployeeClicked();
    void FeedbackClicked() => NavManager.NavigateTo("/feedback");
}