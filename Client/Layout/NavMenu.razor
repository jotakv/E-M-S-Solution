@page "/nav"
@using Microsoft.AspNetCore.Components.Authorization
@using Client.ApplicationStates
@inject DepartmentStates departmentState

<AuthorizeView>
    <Authorized>

        <!-- Top Navbar -->
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    Welcome,
                    @{
                        var fullnameClaim = context.User.Claims
                        .FirstOrDefault(c =>
                        c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name");

                        string fullname = fullnameClaim?.Value ?? "User";
                    }
                    @fullname
                </a>

                <button title="Navigation menu"
                        class="navbar-toggler"
                        @onclick="ToggleNavMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>

        <!-- Side Navigation -->
        <div class="@NavMenuCssClass nav-scrollable">
            <nav class="flex-column">

                <!-- Home -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link p-2" href="/home/dashboard">
                        <span class="bi bi-house-door-fill nav-menu"></span>
                        Home
                    </NavLink>
                </div>

                <!-- Counter -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link p-2" href="counter">
                        <span class="bi bi-plus-square-fill nav-menu"></span>
                        Counter
                    </NavLink>
                </div>

                <!-- Administration -->
                <div class="nav-item px-3">
                    <a class="nav-link p-2"
                       style="cursor:pointer;"
                       @onclick="ShowAdminMenuContainer">
                        <div class="hstack gap-1">
                            <span class="bi bi-person-fill fs-3"></span>
                            <span>Administration</span>
                        </div>
                    </a>

                    <!-- Users submenu -->
                    <a class="nav-link p-2 text-white"
                       style="margin-left:5rem; visibility:@CssStyle">
                        <div class="hstack">
                            <span class="bi bi-people fs-5"></span>
                            <span>Users</span>
                        </div>
                    </a>
                </div>

                <!-- Department Section -->
                <div class="nav-item px-3" style="margin-top:@DepartmentMargin">
                    <a class="nav-link p-2"
                       style="cursor:pointer;"
                       @onclick="ShowDepartmentContainer">
                        <div class="hstack gap-1">
                            <span class="bi bi-backpack4-fill fs-3"></span>
                            <span>Department</span>
                        </div>
                    </a>

                    <div class="nav-link p-2 text-white"
                         style="margin-left:5rem; visibility:@DepartmentSubMenuCssClass">

                        <ul class="list-group" style="list-style:none">

                            <li>
                                <a class="nav-link p-2">
                                    <span class="bi bi-file-medical fs-5"></span>
                                    General
                                </a>
                            </li>

                            <li>
                                <a class="nav-link p-2">
                                    <span class="bi bi-substack fs-5"></span>
                                    Department
                                </a>
                            </li>

                            <li>
                                <a class="nav-link p-2">
                                    <span class="bi bi-chevron-bar-contract fs-5"></span>
                                    Branch
                                </a>
                            </li>

                        </ul>
                    </div>
                </div>

            </nav>
        </div>

    </Authorized>

    <NotAuthorized>
        <!-- Optional: hide nav completely -->
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool collapseNavMenu = false;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public string DepartmentMargin { get; set; } = "-3.5rem";
    private string CssStyle = "hidden";
    public bool ShowHide { get; set; }

    private void ShowAdminMenuContainer()
    {
        ShowHide = !ShowHide;
        CssStyle = ShowHide ? "visible" : "hidden";
        DepartmentMargin = ShowHide ? "0" : "-3.5rem";
    }

    private string DepartmentSubMenuCssClass = "hidden";
    public bool ShowDepartmentSubMenu { get; set; }

    private void ShowDepartmentContainer()
    {
        ShowDepartmentSubMenu = !ShowDepartmentSubMenu;
        DepartmentSubMenuCssClass = ShowDepartmentSubMenu ? "visible" : "hidden";
    }

    void GeneralDepartmentClicked()
    {
        departmentState.GeneralDepartmentClicked();
    }
}
