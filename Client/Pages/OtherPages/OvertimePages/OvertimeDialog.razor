<SfDialog Width="350px"
          IsModal="true"
          ShowCloseIcon="true"
          @bind-Visible="IsVisible">

    <DialogTemplates>
        <Header>@Title Employee's Overtime</Header>

        <Content>
            <EditForm Model="ItemModel" OnValidSubmit="Save">

                <div class="card border-success">
                    <div class="card-body">

                        <!-- Employee ID -->
                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input value="@ItemModel.EmployeeId"
                                   class="form-control"
                                   disabled />
                        </div>

                        <!-- Start Date -->
                        <div class="form-group mt-2">
                            <label class="form-label">Start Date</label>
                            <InputDate @bind-Value="ItemModel.StartDate"
                                       class="form-control" />
                        </div>

                        <!-- End Date -->
                        <div class="form-group mt-2">
                            <label class="form-label">End Date</label>
                            <InputDate @bind-Value="ItemModel.EndDate"
                                       class="form-control" />
                        </div>

                        <!-- Number of Days (READ ONLY PROPERTY) -->
                        <div class="form-group mt-2">
                            <label class="form-label">Number of days</label>
                            <input value="@ItemModel.NumberOfDays"
                                   class="form-control"
                                   disabled />
                        </div>

                        <!-- Overtime Type -->
                        <div class="form-group mt-3">
                            <label class="form-label">Select Type</label>

                            <SfDropDownList TValue="string"
                                            TItem="OvertimeType"
                                            DataSource="OvertimeTypes"
                                            Placeholder="Select Type"
                                            ValueChange="OnValueChange">

                                <DropDownListFieldSettings
                                    Value="Id"
                                    Text="Name">
                                </DropDownListFieldSettings>

                            </SfDropDownList>

                        </div>

                    </div>
                </div>

            </EditForm>
        </Content>
    </DialogTemplates>

    <DialogButtons>
        <DialogButton Content="SAVE"
                      IsPrimary="true"
                      OnClick="Save" />
    </DialogButtons>

</SfDialog>

@code {

    [Parameter] public Overtime ItemModel { get; set; } = new();
    [Parameter] public List<OvertimeType> OvertimeTypes { get; set; } = new();
    [Parameter] public EventCallback<Overtime> HandleSaveOperationEvent { get; set; }

    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Add";

    public void OpenDialog()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (ItemModel.OvertimeTypeld <= 0)
        {
            await dialogService.AlertAsync("You need to provide type.", "Alert!");
            return;
        }

        await HandleSaveOperationEvent.InvokeAsync(ItemModel);
        CloseDialog();
    }

    private void OnValueChange(ChangeEventArgs<string, OvertimeType> args)
    {
        if (!string.IsNullOrEmpty(args.Value))
        {
            ItemModel.OvertimeTypeld = int.Parse(args.Value);
        }
    }

    public void ChangeTitle(string title) => Title = title;
}