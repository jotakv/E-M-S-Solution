@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Microsoft.AspNetCore.Components.Forms
@inject IToastService toastService

<SfDialog Width="350px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title Employee's Overtime</Header>

        <Content>
            <EditForm EditContext="editContext">
                <DataAnnotationsValidator />
                <div class="card border-success">
                    <div class="card-body">

                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input value="@ItemModel.EmployeeId" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Start Date <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="ItemModel.StartDate" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">End Date <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="ItemModel.EndDate" class="form-control" />
                            @if (_showDateError)
                            {
                                <div class="text-danger small mt-1">End date must be after start date.</div>
                            }
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Number of Days</label>
                            <input value="@ItemModel.NumberOfDays" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select Type <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="int"
                                            TItem="OvertimeType"
                                            DataSource="@OvertimeTypes"
                                            Placeholder="Select Type"
                                            @bind-Value="ItemModel.OvertimeTypeld">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                            </SfDropDownList>
                            @if (_showTypeError)
                            {
                                <div class="text-danger small mt-1">Please select an overtime type.</div>
                            }
                        </div>

                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Overtime ItemModel { get; set; } = new();
    [Parameter] public List<OvertimeType> OvertimeTypes { get; set; } = new();
    [Parameter] public EventCallback<Overtime> HandleSaveOperationEvent { get; set; }

    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Add";
    public bool IsSaving { get; set; } = false;
    private bool _showTypeError = false;
    private bool _showDateError = false;

    private EditContext editContext = default!;

    protected override void OnParametersSet()
    {
        editContext ??= new EditContext(ItemModel);
    }

    public void OpenDialog(int employeeId = 0)
    {
        ItemModel = new Overtime { StartDate = DateTime.Now, EndDate = DateTime.Now };
        _showTypeError = false;
        _showDateError = false;
        editContext = new EditContext(ItemModel);
        IsVisible = true;

        if (employeeId > 0)
            ItemModel.EmployeeId = employeeId;

        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        _showTypeError = false;
        _showDateError = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;

    private async Task Save()
    {
        _showTypeError = ItemModel.OvertimeTypeld <= 0;
        _showDateError = ItemModel.EndDate <= ItemModel.StartDate;

        if (_showTypeError || _showDateError)
        {
            StateHasChanged();
            return;
        }

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(ItemModel);

        IsSaving = false;
        CloseDialog();
    }
}
