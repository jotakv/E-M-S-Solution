@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="350px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogEvents OnOpen="OpenDialog"></DialogEvents>

    <DialogTemplates>
        <Header>@Title Overtime Type</Header>
        <Content>
            <EditForm Model="OvertimeType" Enhance OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="OvertimeType.Name" class="form-control" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public OvertimeType OvertimeType { get; set; } = new();
    [Parameter] public EventCallback<OvertimeType> HandleSaveOperationEvent { get; set; }

    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Add";
    public bool IsSaving { get; set; } = false;

    public void OpenDialog()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(OvertimeType.Name))
        {
            await dialogService.AlertAsync("You need to provide OvertimeType name.", "Alert!");
            return;
        }

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(OvertimeType);

        IsSaving = false;
    }
}