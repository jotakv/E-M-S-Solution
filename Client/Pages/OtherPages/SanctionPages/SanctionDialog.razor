@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Microsoft.AspNetCore.Components.Forms
@using Blazored.Toast.Services
@inject IToastService toastService

<SfDialog Width="280px"
          IsModal="true"
          ShowCloseIcon="true"
          @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title Employee's Sanction</Header>

        <Content>
            <EditForm EditContext="editContext">
                <DataAnnotationsValidator />
                <div class="card border-success">
                    <div class="card-body">

                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input @bind="ItemModel.EmployeeId" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Occurring Date</label>
                            <InputDate @bind-Value="ItemModel.Date" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Punishment Date</label>
                            <InputDate @bind-Value="ItemModel.PunishmentDate" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Punishment <span class="text-danger">*</span></label>
                            <InputTextArea @bind-Value="ItemModel.Punishment" class="form-control" rows="2"
                                          placeholder="Describe the punishment..." />
                            <ValidationMessage For="() => ItemModel.Punishment" class="text-danger small mt-1" />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select Type <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="int"
                                            TItem="SanctionType"
                                            Placeholder="Select Type"
                                            DataSource="@SanctionTypes"
                                            @bind-Value="ItemModel.SanctionTypeId">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                            </SfDropDownList>
                        </div>

                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary"
                    type="button"
                    disabled="@IsSaving"
                    @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Sanction ItemModel { get; set; } = new();
    [Parameter] public List<SanctionType> SanctionTypes { get; set; } = new();
    [Parameter] public EventCallback<Sanction> HandleSaveOperationEvent { get; set; }

    public string Title { get; set; } = "Add";
    private bool IsVisible { get; set; } = false;
    public bool IsSaving { get; set; } = false;

    private int OriginalId;
    private EditContext editContext = default!;

    protected override void OnParametersSet()
    {
        editContext = new EditContext(ItemModel);
    }

    public void SetItem(Sanction item)
    {
        ItemModel = item;
        OriginalId = item.Id;
        editContext = new EditContext(ItemModel);
    }

    public void ChangeTitle(string title) => Title = title;

    private async Task Save()
    {
        // Trigger DataAnnotationsValidator — catches empty Punishment
        var formValid = editContext.Validate();

        if (ItemModel.SanctionTypeId <= 0)
        {
            toastService.ShowError("Please select a sanction type.");
            return;
        }

        if (!formValid)
            return;

        // Restore ID so update works
        ItemModel.Id = OriginalId;

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(ItemModel);

        IsSaving = false;

        // Close after save (works for EmployeePage and SanctionPage)
        CloseDialog();
    }

    public void OpenDialog(int employeeId = 0)
    {
        IsVisible = true;

        if (employeeId > 0)
            ItemModel.EmployeeId = employeeId;

        if (ItemModel.Date.Date == DateTime.MinValue.Date)
            ItemModel.Date = DateTime.Now;

        if (ItemModel.PunishmentDate.Date == DateTime.MinValue.Date)
            ItemModel.PunishmentDate = DateTime.Now;

        // Reset validation state on open
        editContext = new EditContext(ItemModel);

        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
