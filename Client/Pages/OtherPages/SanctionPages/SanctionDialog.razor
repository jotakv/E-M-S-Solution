@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Microsoft.AspNetCore.Components.Forms
@inject SfDialogService dialogService

<SfDialog Width="280px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title Employee's Sanction</Header>

        <Content>
            <EditForm Model="ItemModel" OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">

                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input @bind="ItemModel.EmployeeId" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Occurring Date</label>
                            <InputDate @bind-Value="ItemModel.Date" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Punishment Date</label>
                            <InputDate @bind-Value="ItemModel.PunishmentDate" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Punishment</label>
                            <InputTextArea @bind-Value="ItemModel.Punishment" class="form-control" />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select Type</label>
                            <SfDropDownList TValue="int"
                                            TItem="SanctionType"
                                            Placeholder="Select Type"
                                            DataSource="@SanctionTypes"
                                            @bind-Value="ItemModel.SanctionTypeId">
                                <DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </div>

                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Sanction ItemModel { get; set; } = new();
    [Parameter] public List<SanctionType> SanctionTypes { get; set; } = new();
    [Parameter] public EventCallback<Sanction> HandleSaveOperationEvent { get; set; }

    public string Title { get; set; } = "Add";
    private bool IsVisible { get; set; } = false;
    public bool IsSaving { get; set; } = false;

    private async Task Save()
    {
        if (ItemModel.SanctionTypeId <= 0)
        {
            await dialogService.AlertAsync("You need to provide type.", "Alert!");
            return;
        }

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(ItemModel);

        IsSaving = false;
    }

    public void OpenDialog(int employeeId = 0)
    {
        IsVisible = true;

        if (employeeId > 0) ItemModel.EmployeeId = employeeId;

        if (ItemModel.Date.Date == DateTime.MinValue.Date) ItemModel.Date = DateTime.Now;
        if (ItemModel.PunishmentDate.Date == DateTime.MinValue.Date) ItemModel.PunishmentDate = DateTime.Now;

        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title)
    {
        Title = title;
    }
}