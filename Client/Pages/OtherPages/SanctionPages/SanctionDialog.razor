@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="280px"
          IsModal="true"
          ShowCloseIcon="true"
          @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title Employee's Sanction</Header>

        <Content>
            <EditForm EditContext="editContext">
                <DataAnnotationsValidator />
                <div class="card border-success">
                    <div class="card-body">

                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input @bind="ItemModel.EmployeeId" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Occurring Date</label>
                            <InputDate @bind-Value="ItemModel.Date" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Punishment Date</label>
                            <InputDate @bind-Value="ItemModel.PunishmentDate" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Punishment <span class="text-danger">*</span></label>
                            <InputTextArea @bind-Value="ItemModel.Punishment" class="form-control" rows="2"
                                          placeholder="Describe the punishment..." />
                            <ValidationMessage For="() => ItemModel.Punishment" class="text-danger small mt-1" />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select Type <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="int"
                                            TItem="SanctionType"
                                            Placeholder="Select Type"
                                            DataSource="@SanctionTypes"
                                            @bind-Value="ItemModel.SanctionTypeId">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                            </SfDropDownList>
                            <ValidationMessage For="() => ItemModel.SanctionTypeId" class="text-danger small mt-1" />
                        </div>

                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary"
                    type="button"
                    disabled="@IsSaving"
                    @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    // ItemModel is owned by this dialog — NOT a [Parameter].
    // Keeping it internal prevents Blazor's parent re-renders from overwriting
    // the user's in-progress input when the parent calls StateHasChanged().
    public Sanction ItemModel { get; private set; } = new();

    [Parameter] public List<SanctionType> SanctionTypes { get; set; } = new();
    [Parameter] public EventCallback<Sanction> HandleSaveOperationEvent { get; set; }

    public string Title { get; set; } = "Add";
    private bool IsVisible { get; set; } = false;
    public bool IsSaving { get; set; } = false;

    private EditContext editContext = default!;

    protected override void OnInitialized()
    {
        // Create initial editContext once; it is replaced whenever the dialog opens.
        editContext = new EditContext(ItemModel);
    }

    /// <summary>Called by SanctionPage to load an existing record for editing and open the dialog.</summary>
    public void SetItem(Sanction item)
    {
        // Copy into a fresh model so the page's list item is never mutated directly.
        ItemModel = new Sanction
        {
            Id             = item.Id,
            EmployeeId     = item.EmployeeId,
            SanctionTypeId = item.SanctionTypeId,
            Date           = item.Date,
            Punishment     = item.Punishment,
            PunishmentDate = item.PunishmentDate
        };
        editContext = new EditContext(ItemModel);
        // Open the dialog here — do NOT call OpenDialog() afterwards, as that would reset the model.
        IsVisible = true;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;

    private async Task Save()
    {
        var isValid = editContext.Validate();
        if (!isValid)
            return;

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(ItemModel);

        IsSaving = false;
        StateHasChanged();

        CloseDialog();
    }

    /// <summary>Open for Add — creates a fresh model with today's dates.</summary>
    public void OpenDialog(int employeeId = 0)
    {
        ItemModel = new Sanction
        {
            EmployeeId     = employeeId,
            Date           = DateTime.Now,
            PunishmentDate = DateTime.Now
        };
        editContext = new EditContext(ItemModel);

        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }
}
