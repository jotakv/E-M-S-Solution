@implements IDisposable


@if (allState.ShowSanction)
{
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-lg-12">

                <div class="card shadow-lg border-info">
                    <div class="card-header">
                        <h4 class="float-start">Manage Employees Sanctions</h4>
                    </div>

                    <div class="card-body">

                        @{
                            var Tool = new List<string>() { "Search", "ExcelExport", "PdfExport", "Print" };
                        }

                        <SfGrid DataSource="@Sanctions"
                                AllowPaging="true"
                                AllowSorting="true"
                                Toolbar="@Tool"
                                AllowExcelExport="true"
                                AllowPdfExport="true"
                                @ref="DefaultGrid">

                            <GridPageSettings PageSize="5"></GridPageSettings>

                            <GridEvents OnToolbarClick="ToolbarClickHandler"
                                        TValue="Sanction"></GridEvents>

                            <GridColumns>

                                <GridColumn Field=@nameof(Sanction.EmployeeId)
                                            HeaderText="ID">
                                </GridColumn>

                                <GridColumn HeaderText="Type">
                                    <Template>
                                        @{
                                            var sanction = context as Sanction;
                                        }
                                        <div>@sanction!.SanctionType!.Name</div>
                                    </Template>
                                </GridColumn>

                                <GridColumn Field=@nameof(Sanction.Date)
                                            HeaderText="Occuring Date"
                                            Format="d"
                                            Type="ColumnType.Date">
                                </GridColumn>

                                <GridColumn Field=@nameof(Sanction.Punishment)
                                            HeaderText="Punishment">
                                </GridColumn>

                                <GridColumn Field=@nameof(Sanction.PunishmentDate)
                                            HeaderText="Punishment Date"
                                            Format="d"
                                            Type="ColumnType.Date">
                                </GridColumn>

                                <GridColumn HeaderText="Action">
                                    <Template>
                                        @{
                                            var sanction = context as Sanction;
                                        }
                                        <div>
                                            <i class="bi bi-pencil text-info"
                                               id="cursorStyle"
                                               @onclick="() => EditClicked(sanction!)"></i>

                                            <i class="bi bi-trash text-danger"
                                               id="cursorStyle"
                                               @onclick="() => DeleteClicked(sanction!)"></i>
                                        </div>
                                    </Template>
                                </GridColumn>

                            </GridColumns>

                        </SfGrid>

                    </div>

                    <div class="card-footer"></div>

                </div>

            </div>
        </div>
    </div>

    <!-- Dialog Component -->
    <SanctionDialog @ref="sanctionDialog"
                    SanctionTypes="SanctionTypes"
                    HandleSaveOperationEvent="HandleSaveOperationEvent" />
}

<style>
    #cursorStyle {
        cursor: pointer;
    }
</style>

@code {
    private SfGrid<Sanction>? DefaultGrid;
    SanctionDialog? sanctionDialog;

    Sanction ItemModel = new();
    public List<Sanction> Sanctions { get; set; } = new();
    public List<SanctionType> SanctionTypes { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await GetTypes();
        allState.UpdateDashboardAction += RefreshGrid;
        await GetSanctions();

        allState.Action += StateHasChanged;
    }

    private async void RefreshGrid()
    {
        await GetSanctions();
        StateHasChanged();     
    }

    private async Task GetTypes() =>
        SanctionTypes = await sanctionTypeService.GetAll(Constants.SanctionTypeBaseUrl);

    private async Task GetSanctions() =>
        Sanctions = await sanctionService.GetAll(Constants.SanctionBaseUrl);

    void OpenDialog() => sanctionDialog?.OpenDialog();

    // Save (Update only)
    private async Task HandleSaveOperationEvent(Sanction item)
    {
        var result = await sanctionService.Update(item, Constants.SanctionBaseUrl);
        bool successCheck = await DisplayMessage(result.Flag, result.Message);

        if (successCheck)
        {
            ItemModel = new();
            sanctionDialog?.CloseDialog();
            await GetSanctions();
        }
    }

    private void EditClicked(Sanction item)
    {
        // ChangeTitle before SetItem so the header is correct when the dialog opens.
        sanctionDialog!.ChangeTitle("Edit");
        // SetItem copies data into a fresh model AND opens the dialog.
        // Do NOT call OpenDialog() after this — it would reset the model to blank.
        sanctionDialog!.SetItem(item);
    }


    private async Task DeleteClicked(Sanction item)
    {
        bool confirm = await dialogService.ConfirmAsync(
            $"Are you sure you wanna delete this?",
            "Confirm Delete");

        if (!confirm) return;

        var response = await sanctionService.DeleteById(item.Id, Constants.SanctionBaseUrl);
        var result = await DisplayMessage(response.Flag, response.Message);

        if (result)
        {
            await GetSanctions();
            allState.UpdateDashboardAction?.Invoke();
        }
    }

    private Task<bool> DisplayMessage(bool flag, string message)
    {
        if (flag)
            toastService.ShowSuccess(message);
        else
            toastService.ShowError(message);
        return Task.FromResult(flag);
    }

    // Excel / PDF Export / Print
    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        var http = await HttpFactory.GetPrivateHttpClient();

        if (args.Item.Text == "Excel Export")
        {
            await DefaultGrid!.ExportToExcelAsync();
            await http.PostAsJsonAsync("api/audit/export",
                new ExportAuditDto("Sanction", "Excel", Sanctions.Count));
        }
        else if (args.Item.Text == "PDF Export")
        {
            await DefaultGrid!.ExportToPdfAsync();
            await http.PostAsJsonAsync("api/audit/export",
                new ExportAuditDto("Sanction", "PDF", Sanctions.Count));
        }
        else if (args.Item.Text == "Print")
        {
            await http.PostAsJsonAsync("api/audit/print",
                new PrintAuditDto("Sanction", Sanctions.Count));
        }
    }

    public void Dispose()
    {
        allState.Action -= StateHasChanged;

        allState.UpdateDashboardAction -= RefreshGrid;
    }
}
