@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="350px"
          IsModal="true"
          ShowCloseIcon="true"
          @bind-Visible="IsVisible">

    <DialogEvents OnOpen="OpenDialog"></DialogEvents>

    <DialogTemplates>
        <Header>@Title Sanction Type</Header>

        <Content>
            <EditForm Model="LocalModel" Enhance OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="LocalModel.Name" class="form-control" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public SanctionType SanctionType { get; set; } = new();
    private SanctionType LocalModel = new();

    [Parameter] public EventCallback<SanctionType> HandleSaveOperationEvent { get; set; }

    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Add";
    public bool IsSaving { get; set; } = false;

    public void OpenDialog()
    {
        LocalModel = new SanctionType
        {
            Id = SanctionType.Id,
            Name = SanctionType.Name
        };

        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(LocalModel.Name))
        {
            await dialogService.AlertAsync("You need to provide Sanction Type.", "Alert!");
            return;
        }

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(LocalModel);

        IsSaving = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title)
    {
        Title = title;
    }
}