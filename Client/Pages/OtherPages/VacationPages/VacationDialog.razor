@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Microsoft.AspNetCore.Components.Forms
@inject SfDialogService dialogService

<SfDialog Width="280px"
          IsModal="true"
          ShowCloseIcon="true"
          @bind-Visible="IsVisible">

    <DialogTemplates>
        <Header>@Title Employee's Vacation</Header>

        <Content>
            <EditForm Model="ItemModel" OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">

                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input @bind="ItemModel.EmployeeId"
                                   class="form-control"
                                   disabled />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Start Date</label>
                            <InputDate @bind-Value="ItemModel.StartDate"
                                       class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Number of days</label>
                            <InputNumber @bind-Value="ItemModel.NumberOfDays"
                                         class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">End Date</label>
                            <input value="@ItemModel.EndDate.ToString("dd/MM/yyyy")"
                                   type="text"
                                   class="form-control"
                                   disabled />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select Type</label>
                            <SfDropDownList TValue="int"
                                            TItem="VacationType"
                                            Placeholder="Select Type"
                                            DataSource="@VacationTypes"
                                            @bind-Value="ItemModel.VacationTypeId">
                                <DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </div>

                    </div>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>

    <DialogButtons>
        <DialogButton Content="SAVE"
                      Type="ButtonType.Submit"
                      IsPrimary="true"
                      OnClick="Save" />
    </DialogButtons>

</SfDialog>

@code {
    // Inicializamos SOLO el StartDate. El EndDate lo calcula automáticamente tu entidad.
    [Parameter] public Vacation ItemModel { get; set; } = new Vacation { StartDate = DateTime.Now };
    [Parameter] public List<VacationType> VacationTypes { get; set; } = new();
    [Parameter] public EventCallback<Vacation> HandleSaveOperationEvent { get; set; }

    public string Title { get; set; } = "Add";
    private bool IsVisible { get; set; } = false;

    private async void Save()
    {
        if (ItemModel.VacationTypeId <= 0)
        {
            await dialogService.AlertAsync("You need to provide type.", "Alert!");
            return;
        }

        await HandleSaveOperationEvent.InvokeAsync(ItemModel);
    }

    public void OpenDialog(int employeeId = 0)
    {
        if (employeeId > 0)
        {
            ItemModel.EmployeeId = employeeId;
        }

        IsVisible = true;

        if (ItemModel.StartDate.Date == DateTime.MinValue.Date)
        {
            ItemModel.StartDate = DateTime.Now;
        }

        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title)
    {
        Title = title;
    }
}