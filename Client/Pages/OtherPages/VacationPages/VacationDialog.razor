@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Microsoft.AspNetCore.Components.Forms
@inject IToastService toastService

<SfDialog Width="280px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title Employee's Vacation</Header>

        <Content>
            <EditForm EditContext="editContext">
                <DataAnnotationsValidator />
                <div class="card border-success">
                    <div class="card-body">

                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input @bind="ItemModel.EmployeeId" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Start Date</label>
                            <InputDate @bind-Value="ItemModel.StartDate" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Number of days <span class="text-danger">*</span></label>
                            <InputNumber @bind-Value="ItemModel.NumberOfDays" class="form-control" />
                            <ValidationMessage For="() => ItemModel.NumberOfDays" class="text-danger small mt-1" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">End Date</label>
                            <input value="@ItemModel.EndDate.ToString("dd/MM/yyyy")" type="text" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select Type <span class="text-danger">*</span></label>
                            <SfDropDownList TValue="int"
                                            TItem="VacationType"
                                            Placeholder="Select Type"
                                            DataSource="@VacationTypes"
                                            @bind-Value="ItemModel.VacationTypeId">
                                <DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
                            </SfDropDownList>
                            <ValidationMessage For="() => ItemModel.VacationTypeId" class="text-danger small mt-1" />
                        </div>

                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public List<VacationType> VacationTypes { get; set; } = new();
    [Parameter] public EventCallback<Vacation> HandleSaveOperationEvent { get; set; }

    public Vacation ItemModel { get; set; } = new Vacation { StartDate = DateTime.Now };
    public string Title { get; set; } = "Add";
    private bool IsVisible { get; set; } = false;
    public bool IsSaving { get; set; } = false;

    private EditContext editContext = default!;

    protected override void OnInitialized()
    {
        editContext = new EditContext(ItemModel);
    }

    private async Task Save()
    {
        var isValid = editContext.Validate();
        if (!isValid)
            return;

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(ItemModel);

        IsSaving = false;
        CloseDialog();
    }

    public void OpenDialog(int employeeId = 0)
    {
        ItemModel = new Vacation { StartDate = DateTime.Now };
        editContext = new EditContext(ItemModel);
        IsVisible = true;

        if (employeeId > 0) ItemModel.EmployeeId = employeeId;

        StateHasChanged();
    }

    public void OpenDialogForEdit(Vacation vacation)
    {
        ItemModel = vacation;
        editContext = new EditContext(ItemModel);
        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title)
    {
        Title = title;
    }
}
