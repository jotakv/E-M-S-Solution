@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="320px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header> Add Employee Health Issue </Header>
        <Content>
            <EditForm Model="Doctor" OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input @bind="Doctor.EmployeeId" class="form-control" disabled />
                        </div>
                        <div class="form-group mt-2">
                            <label class="form-label">Date</label>
                            <InputDate @bind-Value="Doctor.Date" class="form-control" />
                        </div>
                        <div class="form-group mt-2">
                            <label class="form-label">Medical Diagnose</label>
                            <InputTextArea @bind-Value="Doctor.MedicalDiagnose" class="form-control" />
                        </div>
                        <div class="form-group mt-2">
                            <label class="form-label">Recommendation</label>
                            <InputTextArea @bind-Value="Doctor.MedicalRecommendation" class="form-control" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    public string Title { get; set; } = "Add";

    [Parameter] public Doctor Doctor { get; set; } = new();
    [Parameter] public EventCallback<Doctor> HandleSaveOperationEvent { get; set; }

    private bool IsVisible { get; set; } = false;
    public bool IsSaving { get; set; } = false;

    private async Task Save()
    {
        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(Doctor);

        IsSaving = false;
    }

    public void OpenDialog(int employeeId = 0)
    {
        IsVisible = true;

        if (employeeId > 0) Doctor.EmployeeId = employeeId;
        if (Doctor.Date.Date == DateTime.MinValue.Date) Doctor.Date = DateTime.Now;

        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;
}