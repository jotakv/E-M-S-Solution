@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms
@inject IToastService toastService

<SfDialog Width="340px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>Add Employee Health Issue</Header>
        <Content>
            <EditForm EditContext="editContext">
                <DataAnnotationsValidator />
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input @bind="Doctor.EmployeeId" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Date</label>
                            <InputDate @bind-Value="Doctor.Date" class="form-control" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Medical Diagnose <span class="text-danger">*</span></label>
                            <InputTextArea @bind-Value="Doctor.MedicalDiagnose" class="form-control" rows="2"
                                           placeholder="Enter medical diagnosis..." />
                            <ValidationMessage For="() => Doctor.MedicalDiagnose" class="text-danger small mt-1" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Recommendation <span class="text-danger">*</span></label>
                            <InputTextArea @bind-Value="Doctor.MedicalRecommendation" class="form-control" rows="2"
                                           placeholder="Enter medical recommendation..." />
                            <ValidationMessage For="() => Doctor.MedicalRecommendation" class="text-danger small mt-1" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    public string Title { get; set; } = "Add";

    [Parameter] public Doctor Doctor { get; set; } = new();
    [Parameter] public EventCallback<Doctor> HandleSaveOperationEvent { get; set; }

    private bool IsVisible { get; set; } = false;
    public bool IsSaving { get; set; } = false;

    private EditContext editContext = default!;

    protected override void OnParametersSet()
    {
        editContext ??= new EditContext(Doctor);
    }

    private async Task Save()
    {
        // Trigger DataAnnotationsValidator — catches empty MedicalDiagnose / MedicalRecommendation
        var isValid = editContext.Validate();
        if (!isValid)
            return;

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(Doctor);

        IsSaving = false;
        CloseDialog();
    }

    public void OpenDialog(int employeeId = 0)
    {
        Doctor = new Doctor { Date = DateTime.Now };
        editContext = new EditContext(Doctor);
        IsVisible = true;

        if (employeeId > 0) Doctor.EmployeeId = employeeId;

        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;
}
