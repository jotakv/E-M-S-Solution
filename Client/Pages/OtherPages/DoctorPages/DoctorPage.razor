@implements IDisposable

@if (allState.ShowHealth)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-12">

                <div class="card border-success shadow-lg">
                    <div class="card-header">
                        <h4 class="float-start">Manage Employees' Healths</h4>
                    </div>

                    <div class="card-header"
                         style="max-height:580px; overflow-x:hidden; overflow-y:scroll;">

                        <div class="card-body">

                            @{
                                var Tool = new List<string>() { "Search", "ExcelExport", "PdfExport", "Print" };
                            }

                            <SfGrid DataSource="@Doctors"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    Toolbar="@Tool"
                                    AllowExcelExport="true"
                                    AllowPdfExport="true"
                                    @ref="DefaultGrid">

                                <GridPageSettings PageSize="5"></GridPageSettings>

                                <GridEvents OnToolbarClick="ToolbarClickHandler"
                                            TValue="Doctor"></GridEvents>

                                <GridColumns>

                                    <GridColumn Field=@nameof(Doctor.EmployeeId)
                                                HeaderText="ID">
                                    </GridColumn>

                                    <GridColumn Field=@nameof(Doctor.MedicalDiagnose)
                                                HeaderText="Medical Diagnose">
                                    </GridColumn>

                                    <GridColumn Field=@nameof(Doctor.MedicalRecommendation)
                                                HeaderText="Medical Recommendation">
                                    </GridColumn>

                                    <GridColumn HeaderText="Action">
                                        <Template>
                                            @{
                                                var item = context as Doctor;
                                            }
                                            <div>
                                                <i class="bi bi-pencil text-info cursorStyle"
                                                   @onclick="() => EditClicked(item!)"></i>

                                                <i class="bi bi-trash text-danger cursorStyle"
                                                   @onclick="() => DeleteClicked(item!)"></i>
                                            </div>
                                        </Template>
                                    </GridColumn>

                                </GridColumns>

                            </SfGrid>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
}

<DoctorDialog @ref="doctorDialog"
              Doctor="Doctor"
              HandleSaveOperationEvent="HandleSaveOperationEvent" />

@code {
    private SfGrid<Doctor>? DefaultGrid;
    DoctorDialog? doctorDialog;
    Doctor Doctor = new();
    public List<Doctor> Doctors { get; set; } = new();

    protected async override Task OnInitializedAsync()
    {
        allState.UpdateDashboardAction += RefreshGrid;
        await GetHealth();
        allState.Action += StateHasChanged;
    }

    private async void RefreshGrid()
    {
        await GetHealth(); 
        StateHasChanged();    
    }

    private async Task GetHealth() => Doctors = await doctorService.GetAll(Constants.DoctorBaseUrl);

    void AddButtonClicked()
    {
        Doctor = new();
        OpenDialog();
    }

    void OpenDialog() => doctorDialog?.OpenDialog();

    private async Task HandleSaveOperationEvent(Doctor doctor)
    {
        var result = await doctorService.Update(doctor, Constants.DoctorBaseUrl);
        bool successCheck = await DisplayMessage(result.Flag, result.Message);
        if (successCheck)
        {
            Doctor = new();
            await GetHealth();
        }
    }

    private void EditClicked(Doctor item)
    {
        Doctor = item;
        OpenDialog();
    }

    private async Task DeleteClicked(Doctor item)
    {
        bool confirm = await dialogService.ConfirmAsync($"Are you sure you wanna delete this?", "Confirm Delete");
        if (!confirm) return;

        var response = await doctorService.DeleteById(item.EmployeeId, Constants.DoctorBaseUrl);
        var result = await DisplayMessage(response.Flag, response.Message);
        if (result)
        {
            await GetHealth();
            allState.UpdateDashboardAction?.Invoke();
        }
    }

    private Task<bool> DisplayMessage(bool flag, string message)
    {
        if (flag)
            toastService.ShowSuccess(message);
        else
            toastService.ShowError(message);
        return Task.FromResult(flag);
    }

    public void Dispose() { 
        allState.Action -= StateHasChanged; 
        allState.UpdateDashboardAction -= RefreshGrid;
    }

    // Excel export / PDF Export / Print
    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        var http = await HttpFactory.GetPrivateHttpClient();

        if (args.Item.Text == "Excel Export")
        {
            await DefaultGrid!.ExportToExcelAsync();
            await http.PostAsJsonAsync("api/audit/export",
                new ExportAuditDto("Doctor", "Excel", Doctors.Count));
        }
        else if (args.Item.Text == "PDF Export")
        {
            await DefaultGrid!.ExportToPdfAsync();
            await http.PostAsJsonAsync("api/audit/export",
                new ExportAuditDto("Doctor", "PDF", Doctors.Count));
        }
        else if (args.Item.Text == "Print")
        {
            await http.PostAsJsonAsync("api/audit/print",
                new PrintAuditDto("Doctor", Doctors.Count));
        }
    }
}
