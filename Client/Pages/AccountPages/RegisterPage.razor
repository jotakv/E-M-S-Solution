@page "/identity/account/register"
@layout AuthenticationLayout

<div class="auth-wrapper d-flex align-items-center justify-content-center">
    <div class="auth-card">
        <EditForm Model="User" OnValidSubmit="HandleRegistration">
            <DataAnnotationsValidator />

            <!-- Logo + title -->
            <div class="text-center mb-4">
                <img src="../images/companylogos/netcode.jpg"
                     class="auth-logo mb-3" alt="EMS Logo" />
                <h5 class="fw-semibold mb-1" style="color:#fff; letter-spacing:-0.01em;">
                    Create your account
                </h5>
                <p class="auth-subtitle">Employee Management System</p>
            </div>

            <!-- Inline server error -->
            @if (!string.IsNullOrEmpty(_registerError))
            {
                <div class="auth-error mb-3">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@_registerError
                </div>
            }

            <!-- Full name -->
            <div class="mb-3">
                <label class="auth-label">Full Name</label>
                <InputText @bind-Value="User.Fullname"
                           class="form-control auth-input"
                           placeholder="John Smith" />
                <ValidationMessage For="() => User.Fullname" class="auth-validation" />
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label class="auth-label">Email</label>
                <InputText @bind-Value="User.Email"
                           class="form-control auth-input"
                           placeholder="you@company.com" />
                <ValidationMessage For="() => User.Email" class="auth-validation" />
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label class="auth-label">
                    Password
                    <span class="pw-hint-icon ms-1" title="See requirements below">
                        <i class="bi bi-info-circle text-muted" style="font-size:0.8rem;"></i>
                    </span>
                </label>
                <div class="input-group auth-input-group">
                    <input type="@_passwordType"
                           value="@User.Password"
                           class="form-control auth-input"
                           placeholder="Min. 8 characters"
                           @oninput="OnPasswordInput"
                           autocomplete="new-password" />
                    <button class="auth-eye-btn" type="button"
                            @onclick="TogglePassword" tabindex="-1">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>

                <!-- Strength meter — shown after the user starts typing -->
                @if (_showRequirements)
                {
                    <div class="pw-strength-track mt-2">
                        <div class="pw-strength-fill" style="width:@(_strengthPct)%; background:@_strengthColor; transition:width .3s,background .3s;"></div>
                    </div>
                    <div class="pw-strength-label" style="color:@_strengthColor;">
                        @_strengthLabel
                    </div>

                    <!-- Requirements checklist -->
                    <div class="pw-requirements mt-2">
                        <div class="pw-req @(_lenOk    ? "met" : "unmet")"><i class="bi @(_lenOk    ? "bi-check-circle-fill" : "bi-circle")"></i> At least 8 characters</div>
                        <div class="pw-req @(_hasUpper ? "met" : "unmet")"><i class="bi @(_hasUpper ? "bi-check-circle-fill" : "bi-circle")"></i> Uppercase letter (A–Z)</div>
                        <div class="pw-req @(_hasLower ? "met" : "unmet")"><i class="bi @(_hasLower ? "bi-check-circle-fill" : "bi-circle")"></i> Lowercase letter (a–z)</div>
                        <div class="pw-req @(_hasDigit ? "met" : "unmet")"><i class="bi @(_hasDigit ? "bi-check-circle-fill" : "bi-circle")"></i> Number (0–9)</div>
                        <div class="pw-req @(_hasSpecial ? "met" : "unmet")"><i class="bi @(_hasSpecial ? "bi-check-circle-fill" : "bi-circle")"></i> Special character (!@@#$%&hellip;)</div>
                    </div>
                }

                <ValidationMessage For="() => User.Password" class="auth-validation" />
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label class="auth-label">Confirm Password</label>
                <div class="input-group auth-input-group">
                    <input type="@_confirmType"
                           value="@User.ConfirmPassword"
                           class="form-control auth-input @ConfirmBorderClass"
                           placeholder="Repeat password"
                           @oninput="OnConfirmPasswordInput"
                           autocomplete="new-password" />
                    <button class="auth-eye-btn" type="button"
                            @onclick="ToggleConfirm" tabindex="-1">
                        <i class="bi @(_showConfirm ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                @if (_confirmTouched && !string.IsNullOrEmpty(User.ConfirmPassword))
                {
                    @if (_passwordsMatch)
                    {
                        <div class="d-flex align-items-center gap-1 mt-1">
                            <i class="bi bi-check-circle-fill auth-match-ok"></i>
                            <span class="auth-match-ok" style="font-size:0.78rem;">Passwords match</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-1 mt-1">
                            <i class="bi bi-x-circle-fill auth-match-fail"></i>
                            <span class="auth-match-fail" style="font-size:0.78rem;">Passwords do not match</span>
                        </div>
                    }
                }
            </div>

            <!-- Submit -->
            @if (ShowLoadingButton)
            {
                <ButtonLoadingSpinner></ButtonLoadingSpinner>
            }
            else
            {
                <button class="btn auth-submit-btn w-100 mb-3" type="submit">
                    Create Account
                </button>
            }

            <div class="text-center auth-footer-text">
                Already have an account?
                <a href="identity/account/login" class="auth-link">Sign In</a>
            </div>

        </EditForm>
    </div>
</div>

<style>
    /* ── Strength bar ──────────────────────────────────── */
    .pw-strength-track {
        height: 5px;
        background: rgba(255,255,255,0.12);
        border-radius: 3px;
        overflow: hidden;
    }
    .pw-strength-fill {
        height: 100%;
        border-radius: 3px;
    }
    .pw-strength-label {
        font-size: 0.73rem;
        font-weight: 600;
        margin-top: 3px;
        letter-spacing: 0.02em;
    }

    /* ── Requirements checklist ───────────────────────── */
    .pw-requirements {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .pw-req {
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: color .2s;
    }
    .pw-req.met   { color: #20c997; }
    .pw-req.unmet { color: rgba(255,255,255,0.45); }
    .pw-req i     { font-size: 0.72rem; flex-shrink: 0; }
</style>

@code {
    public bool ShowLoadingButton { get; set; } = false;
    private string _registerError  = string.Empty;

    // ── confirm-field state ─────────────────────────────
    private bool   _confirmTouched = false;
    private bool   _passwordsMatch = false;
    private bool   _showPassword   = false;
    private bool   _showConfirm    = false;
    private string _passwordType   => _showPassword ? "text" : "password";
    private string _confirmType    => _showConfirm  ? "text" : "password";

    // ── strength-meter state ────────────────────────────
    private bool   _showRequirements = false;
    private bool   _lenOk     = false;
    private bool   _hasUpper  = false;
    private bool   _hasLower  = false;
    private bool   _hasDigit  = false;
    private bool   _hasSpecial = false;
    private int    _strengthPct   = 0;
    private string _strengthLabel = string.Empty;
    private string _strengthColor = "#e0e0e0";

    Register User = new();

    void TogglePassword() => _showPassword = !_showPassword;
    void ToggleConfirm()  => _showConfirm  = !_showConfirm;

    [CascadingParameter] public Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string ConfirmBorderClass =>
        !_confirmTouched || string.IsNullOrEmpty(User.ConfirmPassword)
            ? string.Empty
            : _passwordsMatch ? "is-valid-soft" : "is-invalid-soft";

    void OnPasswordInput(ChangeEventArgs e)
    {
        User.Password     = e.Value?.ToString() ?? string.Empty;
        _showRequirements = true;
        EvaluateStrength(User.Password);
        CheckPasswordMatch();
    }

    void OnConfirmPasswordInput(ChangeEventArgs e)
    {
        User.ConfirmPassword = e.Value?.ToString() ?? string.Empty;
        _confirmTouched      = true;
        CheckPasswordMatch();
    }

    void CheckPasswordMatch() =>
        _passwordsMatch = !string.IsNullOrEmpty(User.Password)
                       && User.Password == User.ConfirmPassword;

    void EvaluateStrength(string pwd)
    {
        _lenOk      = pwd.Length >= 8;
        _hasUpper   = pwd.Any(char.IsUpper);
        _hasLower   = pwd.Any(char.IsLower);
        _hasDigit   = pwd.Any(char.IsDigit);
        _hasSpecial = pwd.Any(c => !char.IsLetterOrDigit(c));

        int score = (_lenOk ? 1 : 0) + (_hasUpper ? 1 : 0) + (_hasLower ? 1 : 0)
                  + (_hasDigit ? 1 : 0) + (_hasSpecial ? 1 : 0);

        _strengthPct = score * 20; // 0 → 100 in steps of 20

        (_strengthLabel, _strengthColor) = score switch
        {
            0 or 1 => ("Very Weak", "#dc3545"),
            2      => ("Weak",      "#fd7e14"),
            3      => ("Fair",      "#ffc107"),
            4      => ("Good",      "#20c997"),
            _      => ("Strong",    "#198754"),
        };
    }

    protected async override Task OnInitializedAsync()
    {
        await CheckUserAuthentication();
    }

    async Task HandleRegistration()
    {
        _registerError    = string.Empty;
        ShowLoadingButton = true;
        await Task.Yield();

        var result = await accountService.CreateAsync(User);

        ShowLoadingButton = false;

        if (result.Flag)
        {
            toastService.ShowSuccess("Account created successfully. Please log in.");
            await Task.Delay(1500);
            NavManager.NavigateTo("/identity/account/login");
        }
        else
        {
            _registerError = result.Message;
        }
    }

    private async Task CheckUserAuthentication()
    {
        var user = (await AuthenticationState).User;
        if (user.Identity?.IsAuthenticated == true)
            NavManager.NavigateTo("/home/dashboard");
    }
}
