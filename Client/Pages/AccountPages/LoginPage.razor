@page "/identity/account/login"
@layout AuthenticationLayout

<div class="auth-wrapper d-flex align-items-center justify-content-center">
    <div class="auth-card">
        <EditForm Model="User" OnValidSubmit="HandleLogin" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />

            <!-- Logo + title -->
            <div class="text-center mb-4">
                <img src="../images/companylogos/EMSfavicon.png"
                     class="auth-logo mb-3" alt="EMS Logo" />
                <h5 class="fw-semibold mb-1" style="color:#fff; letter-spacing:-0.01em;">
                    Sign in to EMS
                </h5>
                <p class="auth-subtitle">Employee Management System</p>
            </div>

            <!-- Inline error -->
            @if (!string.IsNullOrEmpty(_loginError))
            {
                <div class="auth-error mb-3">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@_loginError
                </div>
            }

            <!-- Email -->
            <div class="mb-3">
                <label class="auth-label">Email</label>
                <input type="email"
                       value="@User.Email"
                       class="form-control auth-input"
                       placeholder="you@company.com"
                       @oninput="OnEmailInput"
                       autocomplete="username" />
                <ValidationMessage For="() => User.Email" class="auth-validation" />
            </div>

            <!-- Password -->
            <div class="mb-4">
                <label class="auth-label">Password</label>
                <div class="input-group auth-input-group">
                    <input type="@_passwordType"
                           value="@User.Password"
                           class="form-control auth-input"
                           placeholder="Your password"
                           @oninput="OnPasswordInput"
                           autocomplete="current-password" />
                    <button class="auth-eye-btn" type="button"
                            @onclick="TogglePassword" tabindex="-1">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => User.Password" class="auth-validation" />
            </div>

            <!-- Submit -->
            @if (ShowLoadingButton)
            {
                <ButtonLoadingSpinner></ButtonLoadingSpinner>
            }
            else
            {
                <button class="btn auth-submit-btn w-100 mb-3" type="submit">
                    Sign In
                </button>
            }

            <div class="text-center auth-footer-text">
                Don't have an account?
                <a href="identity/account/register" class="auth-link">Sign Up</a>
            </div>

        </EditForm>
    </div>
</div>

@code {
    public bool ShowLoadingButton { get; set; } = false;
    private string _loginError   = string.Empty;
    private bool   _showPassword = false;
    private string _passwordType => _showPassword ? "text" : "password";

    Login User = new();

    void HandleInvalidSubmit() { }
    void TogglePassword() => _showPassword = !_showPassword;

    void OnEmailInput(ChangeEventArgs e)
    {
        User.Email  = e.Value?.ToString() ?? string.Empty;
        _loginError = string.Empty;
    }

    void OnPasswordInput(ChangeEventArgs e)
    {
        User.Password = e.Value?.ToString() ?? string.Empty;
        _loginError   = string.Empty;
    }

    async Task HandleLogin()
    {
        _loginError       = string.Empty;
        ShowLoadingButton = true;
        await Task.Yield();

        var loginSw = System.Diagnostics.Stopwatch.StartNew();
        var result  = await accountService.SignInAsync(User);
        loginSw.Stop();

        Console.WriteLine(
            $"[Perf] Login API round-trip: {loginSw.ElapsedMilliseconds}ms " +
            $"(success={result.Flag})");

        if (result.Flag && loginSw.ElapsedMilliseconds > 2000)
            Console.WriteLine(
                $"[Perf Warning] Login API exceeded 2000ms ({loginSw.ElapsedMilliseconds}ms). " +
                $"BCrypt is ~100-400ms by design; the rest may be DB or network.");

        if (!result.Flag)
        {
            _loginError       = result.Message;
            ShowLoadingButton = false;
            return;
        }

        var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
        await customAuthStateProvider.UpdateAuthenticationState(
            new UserSession
            {
                Token        = result.Token,
                RefreshToken = result.RefreshToken
            });

        Console.WriteLine($"[Perf] Login OnInitializedAsync total: {loginSw.ElapsedMilliseconds}ms");

        toastService.ShowSuccess("Login successful!");
        NavManager.NavigateTo("/home/dashboard", replace: true);
        ShowLoadingButton = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            NavManager.NavigateTo("/home/dashboard", replace: true);
    }
}
