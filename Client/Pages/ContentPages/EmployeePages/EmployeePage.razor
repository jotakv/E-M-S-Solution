@implements IDisposable

@if (allState.ShowEmployee)
{
    if (isLoading)
    {
        <div class="d-flex align-items-center justify-content-center py-5" role="status" aria-live="polite">
            <div class="spinner-border text-primary" aria-hidden="true"></div>
            <span class="ms-3">Loading employees...</span>
        </div>
    }
    else if (ShowMainPage)
    {
        <!-- ── Analytics Charts (collapsible) ──────────────────────────────── -->
        <div class="container-fluid mt-3 px-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold text-muted" style="font-size:0.85rem;">
                    <i class="bi bi-bar-chart-fill text-primary me-1"></i>Analytics Overview
                </span>
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="ToggleCharts"
                        title="@(_chartsVisible ? "Collapse charts" : "Expand charts")">
                    <i class="bi @(_chartsVisible ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                    @(_chartsVisible ? "Collapse" : "Expand")
                </button>
            </div>
            @if (_chartsVisible)
            {
                <DashboardCharts Employees="Employees"
                                 Departments="InitialDepartments"
                                 Overtimes="InitialOvertimes"
                                 Sanctions="InitialSanctions"
                                 Vacations="InitialVacations"
                                 Health="InitialHealth" />
            }
        </div>

        <!-- ── Employee Grid ───────────────────────────────────────────────── -->
        <div class="container-fluid mt-3">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <button class="btn btn-outline-success" @onclick="ShowAddOrUpdateEmployeeButtonClicked">
                                <i class="bi bi-plus-circle-dotted"></i> Add Employee
                            </button>
                        </div>
                        <div class="card-body ems-grid-wrapper">
                            @{
                                var Tool = (new List<string>() { "Search", "ExcelExport", "PdfExport", "Print" });
                            }
                            <SfGrid DataSource="@Employees" AllowPaging="true" AllowSorting="true" Toolbar=@Tool
                                    AllowExcelExport="true" @ref="DefaultGrid" AllowPdfExport="true"
                                    AllowResizing="true">
                                <GridEvents OnToolbarClick="ToolbarClickHandler" TValue="Employee"></GridEvents>
                                <GridColumns>
                                    <GridColumn HeaderText="Employee Image" Width="120" MinWidth="80">
                                        <Template>
                                            @{
                                                var employee = (context as Employee);
                                                <div class="image">
                                                    <img src="@employee!.Photo" alt="@employee.Name" width="150" height="150" />
                                                </div>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(Employee.CivilId)"      HeaderText="Civil ID"    Width="120" MinWidth="80"></GridColumn>
                                    <GridColumn Field="@nameof(Employee.FileNumber)"   HeaderText="File No."    Width="110" MinWidth="80"></GridColumn>
                                    <GridColumn Field="@nameof(Employee.Name)"         HeaderText="Name"        Width="150" MinWidth="100"></GridColumn>
                                    <GridColumn Field="@nameof(Employee.TelephoneNumber)" HeaderText="Phone"    Width="130" MinWidth="90" HideAtMedia="(max-width: 768px)"></GridColumn>
                                    <GridColumn Field="@nameof(Employee.JobName)"      HeaderText="Job Name"    Width="140" MinWidth="90"></GridColumn>
                                    <GridColumn Field="Branch.Name"                    HeaderText="Branch"      Width="130" MinWidth="90" HideAtMedia="(max-width: 900px)"></GridColumn>
                                    <GridColumn Field="Town.Name"                      HeaderText="Town"        Width="120" MinWidth="80" HideAtMedia="(max-width: 900px)"></GridColumn>
                                    <GridColumn HeaderText="Menu" HeaderTextAlign="TextAlign.Left" Width="70" MinWidth="60">
                                        <Template>
                                            @{
                                                var employee = (context as Employee);
                                                <i class="bi bi-menu-down text-primary" id="cursorStyle" @onclick="() => ShowMenuPopUp(employee)"></i>
                                            }
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        </div>
                        <div class="card-footer"></div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<AddOrUpdateEmployeePage @ref="addOrUpdateEmployee"
                         ShowAddOrUpdateEmployee="ShowAddOrUpdatePage"
                         NotifyParentFormCloseClicked="NotifyParentFormCloseClicked"
                         Countries="DefaultCountries"
                         Cities="SelectedCities"
                         Towns="SelectedTowns"
                         GeneralDepartments="DefaultGeneralDepartments"
                         Departments="SelectedDepartments"
                         Branches="SelectedBranches"
                         AllEmployees="Employees"
                         HandleCountrySelectedEvent="HandleCountrySelectedEvent"
                         HandleCitySelectedEvent="HandleCitySelectedEvent"
                         HandleGeneralDepartmentSelectedEvent="HandleGeneralDepartmentSelectedEvent"
                         HandleDepartmentSelectedEvent="HandleDepartmentSelectedEvent"
                         HandleSaveEmployeeClickedEvent="HandleSaveEmployeeClickedEvent" />

<ContextMenu @ref="contextMenu"
             HandleDeleteClicked="DeleteClicked"
             HandleEditClicked="EditClicked"
             HandleViewClicked="ViewClicked"
             HandleAddHealthClicked="AddHealthClicked"
             HandleAddOvertimeClicked="AddOvertimeClicked"
             HandleAddSanctionClicked="AddSanctionClicked"
             HandleAddVacationClicked="AddVacationClicked" />

<DoctorDialog @ref="doctorDialog" HandleSaveOperationEvent="SaveHealthEvent" />
<OvertimeDialog @ref="overtimeDialog" OvertimeTypes="OvertimeTypes" HandleSaveOperationEvent="SaveOvertimeEvent" />
<SanctionDialog @ref="sanctionDialog" SanctionTypes="SanctionTypes" HandleSaveOperationEvent="SaveSanctionEvent" />
<VacationDialog @ref="vacationDialog" VacationTypes="VacationTypes" HandleSaveOperationEvent="SaveVacationEvent" />
<EmployeeDetailPage EmployeeDetails="Employee" ShowDetailsPage="ShowDetailsPage" HandleDetailsPageCloseBtnClicked="HandleDetailsPageCloseBtnClicked" />

@code {
    [Parameter] public List<Employee>?    InitialEmployees    { get; set; }
    [Parameter] public List<Department>?  InitialDepartments  { get; set; }
    [Parameter] public List<Overtime>?    InitialOvertimes    { get; set; }
    [Parameter] public List<Sanction>?    InitialSanctions    { get; set; }
    [Parameter] public List<Vacation>?    InitialVacations    { get; set; }
    [Parameter] public List<Doctor>?      InitialHealth       { get; set; }

    private bool _chartsVisible = true;
    private void ToggleCharts() => _chartsVisible = !_chartsVisible;

    private bool _previousShowEmployeeState = false;
    private bool isLoading = true;
    private SfGrid<Employee>? DefaultGrid;

    AddOrUpdateEmployeePage? addOrUpdateEmployee;
    public List<Employee> Employees { get; set; } = [];
    public Employee Employee { get; set; } = new();

    public List<Country> DefaultCountries { get; set; } = [];
    public List<City> DefaultCities { get; set; } = [];
    public List<Town> DefaultTowns { get; set; } = [];
    public List<GeneralDepartment> DefaultGeneralDepartments { get; set; } = [];
    public List<Department> DefaultDepartments { get; set; } = [];
    public List<Branch> DefaultBranches { get; set; } = [];

    public List<Department> SelectedDepartments { get; set; } = [];
    public List<Branch> SelectedBranches { get; set; } = [];
    public List<City> SelectedCities { get; set; } = [];
    public List<Town> SelectedTowns { get; set; } = [];

    protected async override Task OnInitializedAsync()
    {
        allState.Action += HandleGlobalStateChanged;

        var defaultsTask = LoadDefaults();

        if (InitialEmployees is not null)
        {
            Employees = InitialEmployees.ToList();
            isLoading = false;
        }
        else
        {
            await LoadEmployees();
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }

        await defaultsTask;
    }

    private void HandleGlobalStateChanged()
    {
        if (allState.ShowEmployee && !_previousShowEmployeeState)
        {
            ShowMainPage = true;
            ShowAddOrUpdatePage = false;

            if (addOrUpdateEmployee != null)
            {
                addOrUpdateEmployee.ClearContent();
                addOrUpdateEmployee.FirstLayer = true;
                addOrUpdateEmployee.SecondLayer = false;
            }
        }

        _previousShowEmployeeState = allState.ShowEmployee;
        StateHasChanged();
    }

    private async Task LoadCountriesAsync() =>
        DefaultCountries = await countryService.GetAll(Constants.CountryBaseUrl);

    private async Task LoadCitiesAsync() =>
        DefaultCities = await cityService.GetAll(Constants.CityBaseUrl);

    private async Task LoadTownsAsync() =>
        DefaultTowns = await townService.GetAll(Constants.TownBaseUrl);

    private async Task LoadGeneralDepartmentsAsync() =>
        DefaultGeneralDepartments = await generalDepartmentService.GetAll(Constants.GeneralDepartmentBaseUrl);

    private async Task LoadDepartmentsAsync() =>
        DefaultDepartments = await departmentService.GetAll(Constants.DepartmentBaseUrl);

    private async Task LoadBranchesAsync() =>
        DefaultBranches = await branchService.GetAll(Constants.BranchBaseUrl);

    private async Task LoadTypesAsync()
    {
        VacationTypes = await vacationTypeService.GetAll(Constants.VacationTypeBaseUrl);
        SanctionTypes = await sanctionTypeService.GetAll(Constants.SanctionTypeBaseUrl);
        OvertimeTypes = await overtimeTypeService.GetAll(Constants.OvertimeTypeBaseUrl);
    }

    private async Task LoadDefaults() => await Task.WhenAll(
        LoadCountriesAsync(),
        LoadCitiesAsync(),
        LoadTownsAsync(),
        LoadGeneralDepartmentsAsync(),
        LoadDepartmentsAsync(),
        LoadBranchesAsync(),
        LoadTypesAsync());

    private void HandleCountrySelectedEvent(int countryId)
    {
        SelectedTowns = new();
        SelectedCities = countryId == 0
            ? new()
            : DefaultCities.Where(c => c.CountryId == countryId).ToList();
    }

    private void HandleCitySelectedEvent(int cityId)
    {
        SelectedTowns = cityId == 0
            ? new()
            : DefaultTowns.Where(t => t.CityId == cityId).ToList();
    }

    private void HandleGeneralDepartmentSelectedEvent(int generalDepartmentId)
    {
        SelectedBranches = new();
        SelectedDepartments = generalDepartmentId == 0
            ? new()
            : DefaultDepartments.Where(gd => gd.GeneralDepartmentId == generalDepartmentId).ToList();
    }

    private void HandleDepartmentSelectedEvent(int departmentId)
    {
        SelectedBranches = departmentId == 0
            ? new()
            : DefaultBranches.Where(d => d.DepartmentId == departmentId).ToList();
    }

    private async Task NotifyParentFormCloseClicked()
    {
        ShowMainPage = true;
        ShowAddOrUpdatePage = false;
        await LoadEmployees();
        SelectedEmployee = new();
    }

    private async Task LoadEmployees() =>
        Employees = await employeeService.GetAll(Constants.EmployeeBaseUrl);

    async Task HandleSaveEmployeeClickedEvent(Employee employee)
    {
        bool successCheck = false;

        if (employee.Id > 0)
        {
            var result = await employeeService.Update(employee, Constants.EmployeeBaseUrl);
            successCheck = await DisplayMessage(result.Flag, result.Message);
        }
        else
        {
            var response = await employeeService.Insert(employee, Constants.EmployeeBaseUrl);
            successCheck = await DisplayMessage(response.Flag, response.Message);
        }

        if (successCheck)
        {
            addOrUpdateEmployee!.ClearContent();
            addOrUpdateEmployee!.FirstLayer = true;
            addOrUpdateEmployee!.SecondLayer = false;
            ShowAddOrUpdatePage = false;
            ShowMainPage = true;
            await LoadEmployees();

            allState.UpdateDashboardAction?.Invoke();
        }
    }

    public bool ShowMainPage { get; set; } = true;
    public bool ShowAddOrUpdatePage { get; set; } = false;

    private async Task ShowAddOrUpdateEmployeeButtonClicked()
    {
        await LoadDefaults();

        SelectedCities = new();
        SelectedTowns = new();
        SelectedDepartments = new();
        SelectedBranches = new();

        addOrUpdateEmployee!.ClearContent();
        addOrUpdateEmployee!.FirstLayer = true;
        addOrUpdateEmployee!.SecondLayer = false;
        addOrUpdateEmployee!.Title = "Add";

        addOrUpdateEmployee!.InitializeState();

        ShowMainPage = false;
        ShowAddOrUpdatePage = true;
    }

    private async Task EditClicked()
    {
        contextMenu!.CloseContextMenu();

        var employee = SelectedEmployee;

        SelectedCities = new();
        SelectedTowns = new();
        SelectedDepartments = new();
        SelectedBranches = new();

        await Task.WhenAll(
            LoadCountriesAsync(),
            LoadCitiesAsync(),
            LoadTownsAsync(),
            LoadGeneralDepartmentsAsync(),
            LoadDepartmentsAsync(),
            LoadBranchesAsync(),
            LoadTypesAsync());

        var selectedDepartments = employee.Branch?.Department != null
    ? DefaultDepartments
        .Where(d => d.GeneralDepartmentId == employee.Branch.Department.GeneralDepartmentId)
        .DistinctBy(d => d.Id)
        .ToList()
    : new List<Department>();

        var selectedBranches = employee.Branch != null
            ? DefaultBranches
                .Where(b => b.DepartmentId == employee.Branch.DepartmentId)
                .DistinctBy(b => b.Id)
                .ToList()
            : new List<Branch>();

        var selectedCities = employee.Town?.City != null
            ? DefaultCities
                .Where(c => c.CountryId == employee.Town.City.CountryId)
                .DistinctBy(c => c.Id)
                .ToList()
            : new List<City>();

        var selectedTowns = employee.Town != null
            ? DefaultTowns
                .Where(t => t.CityId == employee.Town.CityId)
                .DistinctBy(t => t.Id)
                .ToList()
            : new List<Town>();
            
        addOrUpdateEmployee!.ClearContent();
        addOrUpdateEmployee!.FirstLayer = true;
        addOrUpdateEmployee!.SecondLayer = false;
        addOrUpdateEmployee!.Title = "Update";

        addOrUpdateEmployee!.Employee.Id = employee.Id;
        addOrUpdateEmployee!.EmployeeGroup1.Name = employee.Name;
        addOrUpdateEmployee!.EmployeeGroup1.TelephoneNumber = employee.TelephoneNumber ?? string.Empty;
        addOrUpdateEmployee!.EmployeeGroup1.FileNumber = employee.FileNumber ?? string.Empty;
        addOrUpdateEmployee!.EmployeeGroup1.Address = employee.Address ?? string.Empty;
        addOrUpdateEmployee!.EmployeeGroup1.Photo = employee.Photo ?? string.Empty;
        addOrUpdateEmployee!.EmployeeGroup1.CivilId = employee.CivilId ?? string.Empty;
        addOrUpdateEmployee!.EmployeeGroup2.JobName = employee.JobName ?? string.Empty;
        addOrUpdateEmployee!.EmployeeGroup2.Other = employee.Other;
        addOrUpdateEmployee!.EmployeeGroup2.BranchId = employee.BranchId;
        addOrUpdateEmployee!.EmployeeGroup2.TownId = employee.TownId;

        SelectedCities = selectedCities;
        SelectedTowns = selectedTowns;
        SelectedDepartments = selectedDepartments;
        SelectedBranches = selectedBranches;

        addOrUpdateEmployee!.GeneralDepartment = employee.Branch?.Department?.GeneralDepartment?.Id;
        addOrUpdateEmployee!.Department = employee.Branch?.Department?.Id;
        addOrUpdateEmployee!.Branch = employee.Branch?.Id;
        addOrUpdateEmployee!.Country = employee.Town?.City?.Country?.Id;
        addOrUpdateEmployee!.City = employee.Town?.City?.Id;
        addOrUpdateEmployee!.Town = employee.Town?.Id;

        addOrUpdateEmployee!.InitializeState();

        SelectedEmployee = new();
        ShowAddOrUpdatePage = true;
        ShowMainPage = false;
    }

    private async Task DeleteClicked()
    {
        contextMenu!.CloseContextMenu();
        bool confirm = await dialogService.ConfirmAsync(
            $"Are you sure you wanna delete {SelectedEmployee.Name}?", "Confirm Delete");
        if (!confirm) return;

        var response = await employeeService.DeleteById(SelectedEmployee.Id, Constants.EmployeeBaseUrl);
        var result = await DisplayMessage(response.Flag, response.Message);
        if (result)
        {
            SelectedEmployee = new();
            await LoadEmployees();
            allState.UpdateDashboardAction?.Invoke();
        }
    }

    private async Task ViewClicked()
    {
        Employee = await employeeService.GetById(SelectedEmployee.Id, Constants.EmployeeBaseUrl)
                   ?? SelectedEmployee;
        contextMenu!.CloseContextMenu();
        ShowDetailsPage = true;
        ShowMainPage = false;
        SelectedEmployee = new();
    }

    DoctorDialog? doctorDialog;

    private void AddHealthClicked()
    {
        contextMenu!.CloseContextMenu();
        doctorDialog!.OpenDialog(SelectedEmployee.Id);
    }

    async Task SaveHealthEvent(Doctor item)
    {
        item.EmployeeId = SelectedEmployee.Id;
        var (flag, message) = await doctorService.Insert(item, Constants.DoctorBaseUrl);
        var response = await DisplayMessage(flag, message);
        if (response)
        {
            SelectedEmployee = new();
            allState.UpdateDashboardAction?.Invoke();
        }
    }

    OvertimeDialog? overtimeDialog;
    List<OvertimeType> OvertimeTypes = [];

    private async Task AddOvertimeClicked()
    {
        contextMenu!.CloseContextMenu();
        OvertimeTypes = await overtimeTypeService.GetAll(Constants.OvertimeTypeBaseUrl);
        overtimeDialog!.OpenDialog(SelectedEmployee.Id);
    }

    async Task SaveOvertimeEvent(Overtime item)
    {
        item.EmployeeId = SelectedEmployee.Id;
        var (flag, message) = await overtimeService.Insert(item, Constants.OvertimeBaseUrl);
        var response = await DisplayMessage(flag, message);
        if (response)
        {
            SelectedEmployee = new();
            allState.UpdateDashboardAction?.Invoke();
        }
    }

    SanctionDialog? sanctionDialog;
    Sanction Sanction = new();
    List<SanctionType> SanctionTypes = [];

    private async Task AddSanctionClicked()
    {
        contextMenu!.CloseContextMenu();
        SanctionTypes = await sanctionTypeService.GetAll(Constants.SanctionTypeBaseUrl);
        sanctionDialog!.OpenDialog(SelectedEmployee.Id);
    }

    async Task SaveSanctionEvent(Sanction item)
    {
        item.EmployeeId = SelectedEmployee.Id;
        var (flag, message) = await sanctionService.Insert(item, Constants.SanctionBaseUrl);
        var response = await DisplayMessage(flag, message);
        if (response)
        {
            SelectedEmployee = new();
            Sanction = new();
            sanctionDialog!.CloseDialog();
            allState.UpdateDashboardAction?.Invoke();
        }
    }

    VacationDialog? vacationDialog;
    List<VacationType> VacationTypes = [];

    private async Task AddVacationClicked()
    {
        contextMenu!.CloseContextMenu();
        VacationTypes = await vacationTypeService.GetAll(Constants.VacationTypeBaseUrl);
        vacationDialog!.OpenDialog(SelectedEmployee.Id);
    }

    async Task SaveVacationEvent(Vacation item)
    {
        item.EmployeeId = SelectedEmployee.Id;
        var (flag, message) = await vacationService.Insert(item, Constants.VacationBaseUrl);
        var response = await DisplayMessage(flag, message);
        if (response)
        {
            SelectedEmployee = new();
            allState.UpdateDashboardAction?.Invoke();
        }
    }

    ContextMenu? contextMenu;
    public bool ShowDetailsPage { get; set; } = false;
    public Employee SelectedEmployee { get; set; } = new();

    void ShowMenuPopUp(Employee? employee)
    {
        if (employee is null) return;
        SelectedEmployee = employee;
        contextMenu!.OpenContextMenu();
    }

    void HandleDetailsPageCloseBtnClicked()
    {
        ShowDetailsPage = false;
        ShowMainPage = true;
    }

    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        var http = await HttpFactory.GetPrivateHttpClient();

        if (args.Item.Text == "Excel Export")
        {
            await this.DefaultGrid!.ExportToExcelAsync();
            await http.PostAsJsonAsync("api/audit/export",
                new ExportAuditDto("Employee", "Excel", Employees.Count));
        }
        else if (args.Item.Text == "PDF Export")
        {
            await this.DefaultGrid!.ExportToPdfAsync();
            await http.PostAsJsonAsync("api/audit/export",
                new ExportAuditDto("Employee", "PDF", Employees.Count));
        }
        else if (args.Item.Text == "Print")
        {
            await http.PostAsJsonAsync("api/audit/print",
                new PrintAuditDto("Employee", Employees.Count));
        }
    }

    private Task<bool> DisplayMessage(bool flag, string message)
    {
        if (flag) toastService.ShowSuccess(message);
        else toastService.ShowError(message);
        return Task.FromResult(flag);
    }

    public void Dispose() => allState.Action -= HandleGlobalStateChanged;
}