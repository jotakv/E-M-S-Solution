@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.DropDowns
@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic
@using System.Threading.Tasks

@implements IDisposable

@if (allState.ShowEmployee && ShowAddOrUpdateEmployee)
{
    <div class="container-fluid px-4">
        <div class="row mt-4 align-items-center">
            <div class="col-auto">
                <i class="bi bi-x-lg fs-3 fw-bold text-danger"
                   style="cursor:pointer"
                   @onclick="CloseForm"></i>
            </div>
            <div class="col text-center">
                <h2>@Title Employee</h2>
            </div>
        </div>

        <div class="row mt-3 mb-4">
            <div class="col-12 d-flex justify-content-center align-items-center gap-2">
                <div class="step-circle active">1</div>
                <div class="step-line @(SecondLayer ? "active" : "inactive")"></div>
                <div class="step-circle @(SecondLayer ? "active" : "inactive")">2</div>
            </div>
        </div>

        @if (FirstLayer)
        {
            <EditForm Model="EmployeeGroup1" OnValidSubmit="Form1">
                <DataAnnotationsValidator />
                <div class="row justify-content-center">

                    <div class="col-lg-4">
                        <div class="fw-bold mb-3" style="font-family:Tahoma; font-size:1.1rem;">Personal Information</div>

                        <div class="form-group mb-3">
                            <label class="form-label">Fullname</label>
                            <InputText class="form-control"
                                       Value="@EmployeeGroup1.Name"
                                       ValueChanged="OnNameChanged"
                                       ValueExpression="() => EmployeeGroup1.Name" />
                            <ValidationMessage For="() => EmployeeGroup1.Name" class="text-danger" />
                            @if (!string.IsNullOrEmpty(_duplicateNameWarning))
                            {
                                <div class="text-warning small mt-1">@_duplicateNameWarning</div>
                            }
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Telephone</label>
                            <InputText class="form-control"
                                       inputmode="tel"
                                       Value="@EmployeeGroup1.TelephoneNumber"
                                       ValueChanged="OnPhoneChanged"
                                       ValueExpression="() => EmployeeGroup1.TelephoneNumber" />
                            <ValidationMessage For="() => EmployeeGroup1.TelephoneNumber" class="text-danger" />
                            @if (!string.IsNullOrEmpty(_duplicatePhoneWarning))
                            {
                                <div class="text-danger small mt-1">@_duplicatePhoneWarning</div>
                            }
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Address</label>
                            <InputTextArea @bind-Value="EmployeeGroup1.Address" class="form-control" />
                            <ValidationMessage For="() => EmployeeGroup1.Address" class="text-danger" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="fw-bold mb-3" style="font-family:Tahoma; font-size:1.1rem;">Other Information</div>

                        <div class="form-group mb-3">
                            <label class="form-label">Civil Id</label>
                            <InputText class="form-control"
                                       placeholder="CIV-000"
                                       Value="@EmployeeGroup1.CivilId"
                                       ValueChanged="OnCivilIdChanged"
                                       ValueExpression="() => EmployeeGroup1.CivilId" />
                            <ValidationMessage For="() => EmployeeGroup1.CivilId" class="text-danger" />
                            @if (!string.IsNullOrEmpty(_duplicateCivilIdWarning))
                            {
                                <div class="text-danger small mt-1">@_duplicateCivilIdWarning</div>
                            }
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">File Number</label>
                            <InputText class="form-control"
                                       placeholder="EMP-000"
                                       Value="@EmployeeGroup1.FileNumber"
                                       ValueChanged="OnFileNumberChanged"
                                       ValueExpression="() => EmployeeGroup1.FileNumber" />
                            <ValidationMessage For="() => EmployeeGroup1.FileNumber" class="text-danger" />
                            @if (!string.IsNullOrEmpty(_duplicateFileNumberWarning))
                            {
                                <div class="text-danger small mt-1">@_duplicateFileNumberWarning</div>
                            }
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label @(ImageUploadMessage == "" ? "" : "text-danger")">
                                @(ImageUploadMessage == "" ? "Upload Image" : ImageUploadMessage)
                            </label>
                            <InputFile class="form-control" OnChange="UploadImage" />
                            <ValidationMessage For="() => EmployeeGroup1.Photo" class="text-danger" />
                        </div>

                        <div class="form-group mt-4 d-flex justify-content-end">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-arrow-right"></i> Next
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(EmployeeGroup1.Photo))
                        {
                            <div class="mt-2">
                                <img src="@EmployeeGroup1.Photo"
                                     alt="Preview"
                                     style="width:150px;height:150px;border-radius:8px;" />
                            </div>
                        }
                    </div>

                </div>
            </EditForm>
        }

        @if (SecondLayer)
        {
            <EditForm Model="EmployeeGroup2" OnValidSubmit="Form2">
                <DataAnnotationsValidator />
                <div class="row justify-content-center">

                    <div class="col-lg-4">
                        <div class="fw-bold mb-3" style="font-family:Tahoma; font-size:1.1rem;">Job Information</div>

                        <div class="form-group mb-3">
                            <label class="form-label">Job Name</label>
                            <InputText @bind-Value="EmployeeGroup2.JobName" class="form-control" />
                            <ValidationMessage For="() => EmployeeGroup2.JobName" class="text-danger" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Select General Department</label>
                            <SfDropDownList TValue="int?"
                                            TItem="GeneralDepartment"
                                            Value="@GeneralDepartment"
                                            Placeholder="Select General Department"
                                            DataSource="@GeneralDepartments"
                                            Width="100%"
                                            PopupHeight="200px">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="int?"
                                                    TItem="GeneralDepartment"
                                                    ValueChange="OnGeneralDepartmentValueChange"
                                                    Opened="@(args => args.Popup.OffsetY = 1)" />
                            </SfDropDownList>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Select Department</label>
                            <SfDropDownList @key="@($"dept_{_departmentListKey}")"
                                            TValue="int?"
                                            TItem="Department"
                                            Value="@Department"
                                            Placeholder="Select Department"
                                            DataSource="@Departments"
                                            Width="100%"
                                            PopupHeight="200px">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="int?"
                                                    TItem="Department"
                                                    ValueChange="OnDepartmentValueChange" />
                            </SfDropDownList>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Select Branch</label>
                            <SfDropDownList @key="@($"branch_{_branchListKey}")"
                                            TValue="int?"
                                            TItem="Branch"
                                            Value="@Branch"
                                            Placeholder="Select Branch"
                                            DataSource="@Branches"
                                            Width="100%"
                                            PopupHeight="200px">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="int?"
                                                    TItem="Branch"
                                                    ValueChange="OnBranchValueChange"
                                                    Opened="@(args => args.Popup.OffsetY = 1)" />
                            </SfDropDownList>
                            <ValidationMessage For="() => EmployeeGroup2.BranchId" class="text-danger" />
                        </div>

                        <div class="form-group mt-4">
                            <button class="btn btn-primary" type="button" @onclick="PrevClicked">
                                <i class="bi bi-arrow-left"></i> Prev
                            </button>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="fw-bold mb-3" style="font-family:Tahoma; font-size:1.1rem;">Location Information</div>

                        <div class="form-group mb-3">
                            <label class="form-label">Select Country</label>
                            <SfDropDownList TValue="int?"
                                            TItem="Country"
                                            Value="@Country"
                                            Placeholder="Select Country"
                                            DataSource="@Countries"
                                            Width="100%"
                                            PopupHeight="200px">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="int?"
                                                    TItem="Country"
                                                    ValueChange="OnCountryValueChange"
                                                    Opened="@(args => args.Popup.OffsetY = 1)" />
                            </SfDropDownList>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Select City</label>
                            <SfDropDownList @key="@($"city_{_cityListKey}")"
                                            TValue="int?"
                                            TItem="City"
                                            Value="@City"
                                            Placeholder="Select City"
                                            DataSource="@Cities"
                                            Width="100%"
                                            PopupHeight="200px">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="int?"
                                                    TItem="City"
                                                    ValueChange="OnCityValueChange"
                                                    Opened="@(args => args.Popup.OffsetY = 1)" />
                            </SfDropDownList>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Select Town</label>
                            <SfDropDownList @key="@($"town_{_townListKey}")"
                                            TValue="int?"
                                            TItem="Town"
                                            Value="@Town"
                                            Placeholder="Select Town"
                                            DataSource="@Towns"
                                            Width="100%"
                                            PopupHeight="200px">
                                <DropDownListFieldSettings Value="Id" Text="Name" />
                                <DropDownListEvents TValue="int?"
                                                    TItem="Town"
                                                    ValueChange="OnTownValueChange"
                                                    Opened="@(args => args.Popup.OffsetY = 1)" />
                            </SfDropDownList>
                            <ValidationMessage For="() => EmployeeGroup2.TownId" class="text-danger" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Other</label>
                            <textarea @bind="EmployeeGroup2.Other" placeholder="Optional" class="form-control"></textarea>
                        </div>

                        <div class="form-group mt-4 d-flex justify-content-end">
                            <button class="btn btn-success" type="submit" disabled="@IsSaving">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span class="ms-1">Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i> <span class="ms-1">Save</span>
                                }
                            </button>
                        </div>
                    </div>

                </div>
            </EditForm>
        }
    </div>
}

<style>
    .step-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
        color: white;
        flex-shrink: 0;
    }

    .step-circle.active { background-color: #1d1858; }
    .step-circle.inactive { background-color: #aaaaaa; }

    .step-line {
        height: 6px;
        width: 400px;
        border-radius: 10px;
    }

    .step-line.active { background-color: #228ada; }
    .step-line.inactive { background-color: #aaaaaa; }
</style>

@code {
    [Parameter] public Employee Employee { get; set; } = new();
    [Parameter] public bool ShowAddOrUpdateEmployee { get; set; }
    [Parameter] public EmployeeGrouping1 EmployeeGroup1 { get; set; } = new();
    [Parameter] public EmployeeGrouping2 EmployeeGroup2 { get; set; } = new();

    [Parameter] public List<Country> Countries { get; set; } = new();
    [Parameter] public List<City> Cities { get; set; } = new();
    [Parameter] public List<Town> Towns { get; set; } = new();
    [Parameter] public List<GeneralDepartment> GeneralDepartments { get; set; } = new();
    [Parameter] public List<Department> Departments { get; set; } = new();
    [Parameter] public List<Branch> Branches { get; set; } = new();

    public bool FirstLayer { get; set; } = true;
    public bool SecondLayer { get; set; } = false;
    public string Title { get; set; } = "Add";

    public int? GeneralDepartment { get; set; } = null;
    public int? Department { get; set; } = null;
    public int? Branch { get; set; } = null;
    public int? Country { get; set; } = null;
    public int? City { get; set; } = null;
    public int? Town { get; set; } = null;

    public bool IsSaving { get; set; } = false;

    private int _departmentListKey = 0;
    private int _branchListKey     = 0;
    private int _cityListKey       = 0;
    private int _townListKey       = 0;

    private List<Department> _previousDepartments = new();
    private List<Branch>     _previousBranches    = new();
    private List<City>       _previousCities      = new();
    private List<Town>       _previousTowns       = new();

    [Parameter] public EventCallback NotifyParentFormCloseClicked { get; set; }
    [Parameter] public EventCallback<Employee> HandleSaveEmployeeClickedEvent { get; set; }
    [Parameter] public EventCallback<int> HandleCountrySelectedEvent { get; set; }
    [Parameter] public EventCallback<int> HandleCitySelectedEvent { get; set; }
    [Parameter] public EventCallback<int> HandleGeneralDepartmentSelectedEvent { get; set; }
    [Parameter] public EventCallback<int> HandleDepartmentSelectedEvent { get; set; }
    [Parameter] public List<Employee> AllEmployees { get; set; } = new();

    private string _duplicateNameWarning    = string.Empty;
    private string _duplicatePhoneWarning   = string.Empty;
    private string _duplicateCivilIdWarning = string.Empty;
    private string _duplicateFileNumberWarning = string.Empty;

    private Task OnNameChanged(string value)
    {
        EmployeeGroup1.Name = value;

        if (string.IsNullOrWhiteSpace(value))
        {
            _duplicateNameWarning = string.Empty;
            return Task.CompletedTask;
        }

        var exists = AllEmployees.Any(e =>
            e.Name.Equals(value.Trim(), StringComparison.OrdinalIgnoreCase) &&
            e.Id != Employee.Id);

        _duplicateNameWarning = exists
            ? "Warning: an employee with this name already exists."
            : string.Empty;

        return Task.CompletedTask;
    }

    private Task OnPhoneChanged(string value)
    {
        EmployeeGroup1.TelephoneNumber = value;

        if (string.IsNullOrWhiteSpace(value))
        {
            _duplicatePhoneWarning = string.Empty;
            return Task.CompletedTask;
        }

        var exists = AllEmployees.Any(e =>
            !string.IsNullOrEmpty(e.TelephoneNumber) &&
            e.TelephoneNumber.Equals(value.Trim(), StringComparison.OrdinalIgnoreCase) &&
            e.Id != Employee.Id);

        _duplicatePhoneWarning = exists
            ? "This telephone number is already used by another employee."
            : string.Empty;

        return Task.CompletedTask;
    }

    private Task OnCivilIdChanged(string value)
    {
        EmployeeGroup1.CivilId = value;

        if (string.IsNullOrWhiteSpace(value))
        {
            _duplicateCivilIdWarning = string.Empty;
            return Task.CompletedTask;
        }

        var exists = AllEmployees.Any(e =>
            !string.IsNullOrEmpty(e.CivilId) &&
            e.CivilId.Equals(value.Trim(), StringComparison.OrdinalIgnoreCase) &&
            e.Id != Employee.Id);

        _duplicateCivilIdWarning = exists
            ? "This Civil ID is already used by another employee."
            : string.Empty;

        return Task.CompletedTask;
    }

    private Task OnFileNumberChanged(string value)
    {
        EmployeeGroup1.FileNumber = value;

        if (string.IsNullOrWhiteSpace(value))
        {
            _duplicateFileNumberWarning = string.Empty;
            return Task.CompletedTask;
        }

        var exists = AllEmployees.Any(e =>
            !string.IsNullOrEmpty(e.FileNumber) &&
            e.FileNumber.Equals(value.Trim(), StringComparison.OrdinalIgnoreCase) &&
            e.Id != Employee.Id);

        _duplicateFileNumberWarning = exists
            ? "This File Number is already used by another employee."
            : string.Empty;

        return Task.CompletedTask;
    }

    // Re-run duplicate checks at submit time (catches pre-populated edit values
    // that the user never typed into, so oninput never fired).
    private void RefreshDuplicateWarnings()
    {
        if (!string.IsNullOrWhiteSpace(EmployeeGroup1.TelephoneNumber))
        {
            var phoneExists = AllEmployees.Any(e =>
                !string.IsNullOrEmpty(e.TelephoneNumber) &&
                e.TelephoneNumber.Equals(EmployeeGroup1.TelephoneNumber.Trim(), StringComparison.OrdinalIgnoreCase) &&
                e.Id != Employee.Id);
            _duplicatePhoneWarning = phoneExists ? "This telephone number is already used by another employee." : string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(EmployeeGroup1.CivilId))
        {
            var civilExists = AllEmployees.Any(e =>
                !string.IsNullOrEmpty(e.CivilId) &&
                e.CivilId.Equals(EmployeeGroup1.CivilId.Trim(), StringComparison.OrdinalIgnoreCase) &&
                e.Id != Employee.Id);
            _duplicateCivilIdWarning = civilExists ? "This Civil ID is already used by another employee." : string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(EmployeeGroup1.FileNumber))
        {
            var fileExists = AllEmployees.Any(e =>
                !string.IsNullOrEmpty(e.FileNumber) &&
                e.FileNumber.Equals(EmployeeGroup1.FileNumber.Trim(), StringComparison.OrdinalIgnoreCase) &&
                e.Id != Employee.Id);
            _duplicateFileNumberWarning = fileExists ? "This File Number is already used by another employee." : string.Empty;
        }
    }

    protected override void OnInitialized()
    {
        allState.Action += StateHasChanged;
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Departments, _previousDepartments))
        {
            _departmentListKey++;
            _previousDepartments = Departments;
        }

        if (!ReferenceEquals(Branches, _previousBranches))
        {
            _branchListKey++;
            _previousBranches = Branches;
        }

        if (!ReferenceEquals(Cities, _previousCities))
        {
            _cityListKey++;
            _previousCities = Cities;
        }

        if (!ReferenceEquals(Towns, _previousTowns))
        {
            _townListKey++;
            _previousTowns = Towns;
        }
    }

    private void ShowLayer2()
    {
        FirstLayer  = false;
        SecondLayer = true;
    }

    private void PrevClicked()
    {
        FirstLayer  = true;
        SecondLayer = false;
    }

    private async Task CloseForm()
    {
        ShowAddOrUpdateEmployee = false;
        await NotifyParentFormCloseClicked.InvokeAsync();
    }

    private string ImageUploadMessage = "";

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.ContentType != "image/png" && file.ContentType != "image/x-png")
        {
            ImageUploadMessage   = "PNG file needed.";
            EmployeeGroup1.Photo = string.Empty;
            return;
        }

        var resized = await file.RequestImageFileAsync("image/png", 300, 300);
        var buffer  = new byte[resized.Size];
        await resized.OpenReadStream().ReadAsync(buffer);

        EmployeeGroup1.Photo = $"data:image/png;base64,{Convert.ToBase64String(buffer)}";
        ImageUploadMessage = "";
        Console.WriteLine("PNG uploaded successfully");

        // Audit after photo is confirmed — never allowed to block the upload
        try
        {
            var client = await HttpFactory.GetPrivateHttpClient();
            await client.PostAsJsonAsync("api/audit/image-upload",
                new ImageUploadAuditDto(Employee.Id, file.Name, file.Size, true));
        }
        catch { /* audit failure must never block photo upload */ }
        ImageUploadMessage   = "";
    }

    private bool ValidateEmployeeGroup1() =>
        !string.IsNullOrEmpty(EmployeeGroup1.Name) &&
        !string.IsNullOrEmpty(EmployeeGroup1.TelephoneNumber) &&
        !string.IsNullOrEmpty(EmployeeGroup1.FileNumber) &&
        !string.IsNullOrEmpty(EmployeeGroup1.Address) &&
        !string.IsNullOrEmpty(EmployeeGroup1.Photo) &&
        !string.IsNullOrEmpty(EmployeeGroup1.CivilId);

    private bool ValidateEmployeeGroup2() =>
        !string.IsNullOrEmpty(EmployeeGroup2.JobName) &&
        EmployeeGroup2.TownId   != 0 &&
        EmployeeGroup2.BranchId != 0;

    private void Form1()
    {
        // Always re-run duplicate checks at submit (covers pre-populated Edit values
        // where the user never typed, so the oninput handlers never fired).
        RefreshDuplicateWarnings();

        if (!string.IsNullOrEmpty(_duplicatePhoneWarning) ||
            !string.IsNullOrEmpty(_duplicateCivilIdWarning) ||
            !string.IsNullOrEmpty(_duplicateFileNumberWarning))
            return; // Inline errors are already displayed — block progression.

        if (ValidateEmployeeGroup1())
        {
            Employee.Name            = EmployeeGroup1.Name;
            Employee.TelephoneNumber = EmployeeGroup1.TelephoneNumber;
            Employee.Address         = EmployeeGroup1.Address;
            Employee.CivilId         = EmployeeGroup1.CivilId;
            Employee.FileNumber      = EmployeeGroup1.FileNumber;
            Employee.Photo           = EmployeeGroup1.Photo;
            ShowLayer2();
        }
    }

    private async Task Form2()
    {
        if (ValidateEmployeeGroup2())
        {
            IsSaving = true;
            StateHasChanged();
            await Task.Yield();

            Employee.JobName  = EmployeeGroup2.JobName;
            Employee.Other    = EmployeeGroup2.Other;
            Employee.BranchId = EmployeeGroup2.BranchId;
            Employee.TownId   = EmployeeGroup2.TownId;

            await HandleSaveEmployeeClickedEvent.InvokeAsync(Employee);

            IsSaving = false;
            StateHasChanged();
        }
        else
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    public void ClearContent()
    {
        Employee       = new();
        EmployeeGroup1 = new();
        EmployeeGroup2 = new();

        GeneralDepartment = null;
        Department        = null;
        Branch            = null;
        Country           = null;
        City              = null;
        Town              = null;

        _duplicateNameWarning       = string.Empty;
        _duplicatePhoneWarning      = string.Empty;
        _duplicateCivilIdWarning    = string.Empty;
        _duplicateFileNumberWarning = string.Empty;
    }

    public async Task OnGeneralDepartmentValueChange(ChangeEventArgs<int?, GeneralDepartment> args)
    {
        if (!args.IsInteracted) return;

        GeneralDepartment = args.Value;
        EmployeeGroup2.GeneralDepartmentId = args.Value ?? 0;
        Department = null;
        EmployeeGroup2.DepartmentId = 0;
        Branch = null;
        EmployeeGroup2.BranchId = 0;

        int id = args.Value ?? 0;
        await HandleGeneralDepartmentSelectedEvent.InvokeAsync(id);
    }

    public async Task OnDepartmentValueChange(ChangeEventArgs<int?, Department> args)
    {
        if (!args.IsInteracted) return;

        Department = args.Value;
        EmployeeGroup2.DepartmentId = args.Value ?? 0;
        Branch = null;
        EmployeeGroup2.BranchId = 0;

        int id = args.Value ?? 0;
        await HandleDepartmentSelectedEvent.InvokeAsync(id);
    }

    public void OnBranchValueChange(ChangeEventArgs<int?, Branch> args)
    {
        if (!args.IsInteracted) return;

        Branch = args.Value;
        EmployeeGroup2.BranchId = args.Value ?? 0;
    }

    public async Task OnCountryValueChange(ChangeEventArgs<int?, Country> args)
    {
        if (!args.IsInteracted) return;

        Country = args.Value;
        EmployeeGroup2.CountryId = args.Value ?? 0;
        City = null;
        EmployeeGroup2.CityId = 0;
        Town = null;
        EmployeeGroup2.TownId = 0;

        int id = args.Value ?? 0;
        await HandleCountrySelectedEvent.InvokeAsync(id);
    }

    public async Task OnCityValueChange(ChangeEventArgs<int?, City> args)
    {
        if (!args.IsInteracted) return;

        City = args.Value;
        EmployeeGroup2.CityId = args.Value ?? 0;
        Town = null;
        EmployeeGroup2.TownId = 0;

        int id = args.Value ?? 0;
        await HandleCitySelectedEvent.InvokeAsync(id);
    }

    public void OnTownValueChange(ChangeEventArgs<int?, Town> args)
    {
        if (!args.IsInteracted) return;

        Town = args.Value;
        EmployeeGroup2.TownId = args.Value ?? 0;
    }

    public void Dispose()
    {
        allState.Action -= StateHasChanged;
    }
}
