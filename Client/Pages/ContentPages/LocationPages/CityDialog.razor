@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="280px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title City</Header>

        <Content>
            <EditForm Model="LocalModel" Enhance OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Id</label>
                            <input @bind="LocalModel.Id" class="form-control" disabled />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="LocalModel.Name" class="form-control" />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select Country</label>
                            <SfDropDownList TValue="int" TItem="Country"
                                            Value="@LocalModel.CountryId"
                                            Placeholder="Select Country"
                                            DataSource="Countries">
                                <DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
                                <DropDownListEvents TValue="int" TItem="Country"
                                                    ValueChange="OnValueChange"></DropDownListEvents>
                            </SfDropDownList>
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public City City { get; set; } = new();
    [Parameter] public List<Country> Countries { get; set; } = new();
    [Parameter] public EventCallback<City> HandleSaveOperationEvent { get; set; }

    private City LocalModel = new();

    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Add";
    public bool IsSaving { get; set; } = false;

    public void OpenDialog()
    {
        LocalModel = new City
        {
            Id        = City.Id,
            Name      = City.Name,
            CountryId = City.CountryId,
            Country   = City.Country
        };
        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public async Task Save()
    {
        if (string.IsNullOrWhiteSpace(LocalModel.Name) || LocalModel.CountryId <= 0)
        {
            await dialogService.AlertAsync("You need to provide a City name and select a Country.", "Alert!");
            return;
        }

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(LocalModel);

        IsSaving = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;

    public void OnValueChange(ChangeEventArgs<int, Country> args)
    {
        LocalModel.CountryId = args.Value;
    }
}
