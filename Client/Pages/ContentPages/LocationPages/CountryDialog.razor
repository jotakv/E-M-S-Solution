@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="280px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title Country</Header>
        <Content>
            <EditForm Model="LocalModel" Enhance OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Id</label>
                            <input @bind="LocalModel.Id" class="form-control" disabled />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="LocalModel.Name" class="form-control" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Country Country { get; set; } = new();
    [Parameter] public EventCallback<Country> HandleSaveOperationEvent { get; set; }

    private Country LocalModel = new();

    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Add";
    public bool IsSaving { get; set; } = false;

    public void OpenDialog()
    {
        LocalModel = new Country
        {
            Id   = Country.Id,
            Name = Country.Name
        };
        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public async Task Save()
    {
        if (string.IsNullOrWhiteSpace(LocalModel.Name))
        {
            await dialogService.AlertAsync("You need to provide a Country name.", "Alert!");
            return;
        }

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(LocalModel);

        IsSaving = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;
}
