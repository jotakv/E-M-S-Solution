@implements IDisposable

@if (allState.ShowCity)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">

                    <div class="card-header">
                        <h4 class="float-start">Cities</h4>
                        <button class="btn btn-outline-success float-end" @onclick="AddButtonClicked">
                            <i class="bi bi-plus-circle-dotted"></i>
                        </button>
                    </div>

                    <div class="card-body" style="max-height: 580px; overflow-x:hidden; overflow-y:scroll;">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Id</th>
                                    <th scope="col">Country</th>
                                    <th scope="col">City</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Cities is not null && Cities.Any())
                                {
                                    var count = 1;

                                    foreach (var item in Cities)
                                    {
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>@item.Id</td>
                                            <td>@item.Country!.Name</td>
                                            <td>@item.Name</td>
                                            <td>
                                                <i class="bi bi-pencil text-info" id="cursorStyle"
                                                   @onclick="() => EditClicked(item)"></i>
                                                <i class="bi bi-trash text-danger" id="cursorStyle"
                                                   @onclick="() => DeleteClicked(item)"></i>
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="alert alert-info text-center">
                                                No City added yet!
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
}



<style>
    cursorStyle {
        cursor: pointer;
    }
</style>

<CityDialog @ref="cityDialog"
               HandleSaveOperationEvent="HandleSaveOperationEvent"
               City="City"
               Countries="Countries"/>

@code {

    public string Title { get; set; } = "Add";
    CityDialog? cityDialog;
    City City = new();
    public List<City> Cities { get; set; } = new();
    public List<Country> Countries { get; set; } = new();


    public void Dispose()
    {
        allState.Action -= HandleStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await GetCities();
        await GetCountries();
        allState.Action += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (allState.ShowCity)
            {
                await GetCities();
                await GetCountries();
            }

            StateHasChanged();
        });
    }

    private async Task GetCountries()
    {
        Countries = await countryService.GetAll(Constants.CountryBaseUrl);
    }
    private async Task GetCities()
    {
        Cities = await cityService.GetAll(Constants.CityBaseUrl);
    }


    private async Task AddButtonClicked()
    {
        await GetCountries();

        cityDialog?.ChangeTitle("Add");
        City = new();
        OpenDialog();
    }

    private async Task EditClicked(City city)
    {
        await GetCountries();

        cityDialog?.ChangeTitle("Update");
        City = city;
        OpenDialog();
    }

    private void OpenDialog()
    {
        cityDialog?.OpenDialog();
    }

    private async Task HandleSaveOperationEvent(City city)
    {
        bool successCheck;

        if (city.Id > 0)
        {
            var result = await cityService.Update(city, Constants.CityBaseUrl);
            successCheck = await DisplayMessage(result.Flag, result.Message);
        }
        else
        {
            var response = await cityService.Insert(city, Constants.CityBaseUrl);
            successCheck = await DisplayMessage(response.Flag, response.Message);
        }

        if (successCheck)
        {
            City = new();
            await GetCities();
            cityDialog?.ChangeTitle("Add");
            cityDialog?.CloseDialog();
        }
    }

    private async Task DeleteClicked(City city)
    {
        bool confirm = await dialogService.ConfirmAsync(
            $"Are you sure you wanna delete {city.Name}?",
            "Confirm Delete");

        if (!confirm) return;

        var response = await cityService.DeleteById(city.Id, Constants.CityBaseUrl);
        var result = await DisplayMessage(response.Flag, response.Message);

        if (result)
            await GetCities();
    }

    private Task<bool> DisplayMessage(bool flag, string message)
    {
        if (flag)
            toastService.ShowSuccess(message);
        else
            toastService.ShowError(message);
        return Task.FromResult(flag);
    }


}


