@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Popups
@using Microsoft.AspNetCore.Components.Forms

<SfDialog Width="280px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogTemplates>
        <Header>@Title Department</Header>

        <Content>
            <EditForm Model="LocalModel" Enhance OnSubmit="Save">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Id</label>
                            <input @bind="LocalModel.Id" class="form-control" disabled />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="LocalModel.Name" class="form-control" />
                        </div>

                        <div class="form-group mt-3 mb-3">
                            <label class="form-label">Select General Department</label>
                            <SfDropDownList TValue="int" TItem="GeneralDepartment"
                                            Value="@LocalModel.GeneralDepartmentId"
                                            Placeholder="Select General Department"
                                            DataSource="GeneralDepartments">
                                <DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
                                <DropDownListEvents TValue="int" TItem="GeneralDepartment"
                                                    ValueChange="OnValueChange"></DropDownListEvents>
                            </SfDropDownList>
                        </div>
                    </div>
                </div>
            </EditForm>
        </Content>

        <FooterTemplate>
            <button class="btn btn-primary" type="button" disabled="@IsSaving" @onclick="Save">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Saving...</span>
                }
                else
                {
                    <span>SAVE</span>
                }
            </button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Department Department { get; set; } = new();
    [Parameter] public List<GeneralDepartment> GeneralDepartments { get; set; } = new();
    [Parameter] public EventCallback<Department> HandleSaveOperationEvent { get; set; }

    private Department LocalModel = new();

    private bool IsVisible { get; set; } = false;
    public string Title { get; set; } = "Add";
    public bool IsSaving { get; set; } = false;

    public void OpenDialog()
    {
        LocalModel = new Department
        {
            Id                  = Department.Id,
            Name                = Department.Name,
            GeneralDepartmentId = Department.GeneralDepartmentId,
            GeneralDepartment   = Department.GeneralDepartment
        };
        IsVisible = true;
        StateHasChanged();
    }

    public void CloseDialog()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public async Task Save()
    {
        if (string.IsNullOrWhiteSpace(LocalModel.Name) || LocalModel.GeneralDepartmentId <= 0)
        {
            await dialogService.AlertAsync("You need to provide a Department name and select a General Department.", "Alert!");
            return;
        }

        IsSaving = true;
        StateHasChanged();

        await HandleSaveOperationEvent.InvokeAsync(LocalModel);

        IsSaving = false;
        StateHasChanged();
    }

    public void ChangeTitle(string title) => Title = title;

    public void OnValueChange(ChangeEventArgs<int, GeneralDepartment> args)
    {
        LocalModel.GeneralDepartmentId = args.Value;
    }
}
